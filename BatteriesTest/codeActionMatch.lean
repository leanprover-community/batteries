import Batteries.CodeAction.Match

open Lean Elab Batteries.CodeAction

/-!
Regression test for #1502: `isMatchTerm` should match explicit `match` terms
with original source info and ignore synthetic `match` nodes generated by
macros such as `@fun` or equation compilers.
-/
#eval show Command.CommandElabM Unit from do
  -- An explicit `match` atom with `.original` source info is recognized.
  let origInfo := SourceInfo.original "".toRawSubstring ⟨0⟩ "".toRawSubstring ⟨5⟩
  let origMatch := Syntax.node .none ``Lean.Parser.Term.match #[Syntax.atom origInfo "match"]
  let origTermInfo : Info := .ofTermInfo {
    elaborator := .anonymous
    stx := origMatch
    lctx := {}
    expectedType? := none
    expr := .sort .zero
  }
  if !isMatchTerm origTermInfo then
    throwError "expected isMatchTerm to accept explicit match with original source info"

  -- A synthetic `match` node (e.g. from `@fun` or equation compilation) is ignored.
  let synthInfo := SourceInfo.synthetic ⟨0⟩ ⟨5⟩
  let synthMatch := Syntax.node .none ``Lean.Parser.Term.match #[Syntax.atom synthInfo "match"]
  let synthTermInfo : Info := .ofTermInfo {
    elaborator := .anonymous
    stx := synthMatch
    lctx := {}
    expectedType? := none
    expr := .sort .zero
  }
  if isMatchTerm synthTermInfo then
    throwError "expected isMatchTerm to reject synthetic match"
