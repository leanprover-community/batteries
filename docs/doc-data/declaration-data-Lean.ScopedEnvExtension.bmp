{"declarations":[{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/ScopedEnvExtension.html#Lean.registerSimpleScopedEnvExtensionWithSummaries\"><span class=\"name\">Lean</span>.<span class=\"name\">registerSimpleScopedEnvExtensionWithSummaries</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α </span><span class=\"fn\">σ </span><span class=\"fn\">ι</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">descr</span> : <span class=\"fn\"><a href=\"./Lean/ScopedEnvExtension.html#Lean.SimpleScopedEnvExtension.Descr\">SimpleScopedEnvExtension.Descr</a> <span class=\"fn\">α</span> <span class=\"fn\">σ</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">build</span> : <span class=\"fn\"><a href=\"./Lean/Environment.html#Lean.Environment\">Environment</a> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">α</span></span> → <span class=\"fn\">ι</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">addImported</span> : <span class=\"fn\"><span class=\"fn\">σ</span> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> (<span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">ι</span></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Lean/ScopedEnvExtension.html#Lean.ScopedEnvExtension.Entry\">ScopedEnvExtension.Entry</a> <span class=\"fn\">α</span>)</span></span>)</span> → <span class=\"fn\"><a href=\"./Lean/Environment.html#Lean.ImportM\">ImportM</a> <span class=\"fn\">σ</span></span></span></span>)</span></span> <span class=\"decl_args\"