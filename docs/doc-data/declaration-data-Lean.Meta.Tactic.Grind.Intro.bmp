283-L284"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Intro.html#Lean.Meta.Grind.preprocessHypothesis\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">preprocessHypothesis</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.GoalM\">GoalM</a> <a href=\"./Lean/Meta/Tactic/Simp/Types.html#Lean.Meta.Simp.Result\">Simp.Result</a></span></div></div>","info":{"doc":"Similar to `Grind.preprocess`, but does not simplify `e` if it looks like a\n`match`-expression condition (see `isMatchCondHyp`).\nWe added this feature because it may be coming from external sources\n(e.g., manually applying an function induction principle before invoking `grind`).\nOther hypotheses are simplified as usual, and become available for E-matching (issue #15697).","docLink":"./Lean/Meta/Tactic/Grind/Intro.html#Lean.Meta.Grind.preprocessHypothesis","kind":"def","line":95,"name":"Lean.Meta.Grind.preprocessHypothesis","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Intro.lean#L95-L109"}}],"imports":["Init.Data.List.MapIdx","Init.Grind.Lemmas","Init.Grind.Util","Lean.Meta.Tactic.Apply","Lean.Meta.Tactic.Grind.Action","Lean.Meta.Tactic.Grind.Anchor","Lean.Meta.Tactic.Grind.CasesMatch","Lean.Meta.Tactic.Grind.Core","Lean.Meta.Tactic.Grind.Injection","Lean.Meta.Tactic.Grind.MarkAccessible","Lean.Meta.Tactic.Grind.Simp","Lean.Meta.Tactic.Grind.Util"],"instances":[],"name":"Lean.Meta.Tactic.Grind.Intro"}