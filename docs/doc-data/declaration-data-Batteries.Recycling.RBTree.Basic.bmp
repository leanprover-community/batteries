\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">v</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">r</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"A node consists of a value `v`, a subtree `l` of smaller items,\nand a subtree `r` of larger items. The color `c` is either `red` or `black`\nand participates in the red-black balance invariant (see `Balanced`). ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.node","kind":"ctor","line":54,"name":"RBTree.RBNode.node","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L54-L57"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.nil\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">nil</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"An empty tree. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.nil","kind":"ctor","line":52,"name":"RBTree.RBNode.nil","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L52-L53"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a> u</div></div>","info":{"doc":"A red-black tree. (This is an internal implementation detail of the `RBSet` type,\nwhich includes the invariants of the tree.) This is a binary search tree augmented with\na \"color\" field which is either red or black for each node and used to implement\nthe re-balancing operations.\nSee: [Red–black tree](https://en.wikipedia.org/wiki/Red%E2%80%93black_tree)\n","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode","kind":"inductive","line":44,"name":"RBTree.RBNode","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L44-L58"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.instReprRBColor.repr\"><span class=\"name\">RBTree</span>.<span class=\"name\">instReprRBColor</span>.<span class=\"name\">repr</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor\">RBColor</a> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <a href=\"./Init/Data/Format/Basic.html#Std.Format\">Std.Format</a></span></span></div></div>","info":{"doc":"","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.instReprRBColor.repr","kind":"def","line":42,"name":"RBTree.instReprRBColor.repr","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L42-L42"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.instReprRBColor\"><span class=\"name\">RBTree</span>.<span class=\"name\">instReprRBColor</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Repr.html#Repr\">Repr</a> <a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor\">RBColor</a></span></div></div>","info":{"doc":"","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.instReprRBColor","kind":"instance","line":42,"name":"RBTree.instReprRBColor","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L42-L42"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor.black\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBColor</span>.<span class=\"name\">black</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor\">RBColor</a></div></div>","info":{"doc":"Every path from the root to a leaf must pass through the same number of black nodes. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor.black","kind":"ctor","line":40,"name":"RBTree.RBColor.black","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L40-L41"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor<