ies/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">v</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">parent</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path\">Path</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path\">Path</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"A path that goes down the right subtree. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path.right","kind":"ctor","line":467,"name":"RBTree.RBNode.Path.right","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L467-L468"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path.left\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">Path</span>.<span class=\"name\">left</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor\">RBColor</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">parent</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path\">Path</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">v</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">r</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path\">Path</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"A path that goes down the left subtree. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path.left","kind":"ctor","line":465,"name":"RBTree.RBNode.Path.left","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L465-L466"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path.root\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">Path</span>.<span class=\"name\">root</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path\">Path</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"The root of the tree, which is the end of the path of parents. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path.root","kind":"ctor","line":463,"name":"RBTree.RBNode.Path.root","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L463-L464"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">Path</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a> u</div></div>","info":{"doc":"A `RBNode.Path α` is a \"cursor\" into an `RBNode` which represents the path\nfrom the root to a subtree. Note that the path goes from the target subtree\nup to the root, which is reversed from the normal way data is stored in the tree.\nSee [Zipper](https://en.wikipedia.org/wiki/Zipper_(data_structure)) for more information.\n","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.Path","kind":"inductive","line":456,"name":"RBTree.RBNode.Path","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L456-L468"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.toArray\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">toArray</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"Converts the tree into an array in increasing sorted order. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.toArray","kind":"def","line":453,"name":"RBTree.RBNode.toArray","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L453-L454"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.map\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">map</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a> u_2}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\">β</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span> → <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">β</span></span></span></div></div>","info":{"doc":"`O(n)`. Map a function on every value in the tree.\nThis requires `IsMonotone` on the function in order to preserve the order invariant.\n","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.map","kind":"def","line":445,"name":"RBTree.RBNode.map","sourceLink":"https://github.com/leanprover-community/batteries/bl