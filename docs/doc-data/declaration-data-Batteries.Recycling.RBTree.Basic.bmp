ypes.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">v</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">r</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"Rebalancing a tree which has shrunk on the left. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.balLeft","kind":"def","line":344,"name":"RBTree.RBNode.balLeft","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L344-L351"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.setRed\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">setRed</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span> → <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></span></div></div>","info":{"doc":"Recolor the root of the tree to `red` if possible. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.setRed","kind":"def","line":339,"name":"RBTree.RBNode.setRed","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L339-L342"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.insert\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">insert</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">cmp</span> : <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\">α</span> → <a href=\"./Init/Data/Ord/Basic.html#Ordering\">Ordering</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">t</span> : <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">v</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"`insert cmp t v` inserts element `v` into the tree, using the provided comparator\n`cmp` to put it in the right place and automatically rebalancing the tree as necessary.\n","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.insert","kind":"def","line":328,"name":"RBTree.RBNode.insert","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L328-L335"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.ins\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">ins</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">cmp</span> : <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\">α</span> → <a href=\"./Init/Data/Ord/Basic.html#Ordering\">Ordering</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\">α</span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span> → <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></span></div></div>","info":{"doc":"The core of the `insert` function. This adds an element `x` to a balanced red-black tree.\nImportantly, the result of calling `ins` is not a proper red-black tree,\nbecause it has a broken balance invariant.\n(See `Balanced.ins` for the balance invariant of `ins`.)\nThe `insert` function does the final fixup needed to restore the invariant.\n","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.ins","kind":"def","line":308,"name":"RBTree.RBNode.ins","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L308-L326"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.reverse\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">reverse</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span> → <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></span></div></div>","info":{"doc":"`O(n)`. Reverses the ordering of the tree without any rebalancing. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.reverse","kind":"def","line":301,"name":"RBTree.RBNode.reverse","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L301-L304"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.setBlack\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">setBlack</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span> → <span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span></span></div></div>","info":{"doc":"Changes the color of the root to `black`. ","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.setBlack","kind":"def","line":296,"name":"RBTree.RBNode.setBlack","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L296-L299"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.isBlack\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">isBlack</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span>\n</span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode\">RBNode</a> <span class=\"fn\">α</span></span> → <a href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBColor\">RBColor</a></span></div></div>","info":{"doc":"Returns `black` if the node is black, otherwise `red`.\n(Nil nodes are treated as `red`, which is not the usual convention but useful for deletion.)\n","docLink":"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.isBlack","kind":"def","line":288,"name":"RBTree.RBNode.isBlack","sourceLink":"https://github.com/leanprover-community/batteries/blob/3a067208130fab4154e6a4dd29efd07e3a9466bd/Batteries/Recycling/RBTree/Basic.lean#L288-L294"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Batteries/Recycling/RBTree/Basic.html#RBTree.RBNode.isRed\"><span class=\"name\">RBTree</span>.<span class=\"name\">RBNode</span>.<span class=\"name\">isRed</spa