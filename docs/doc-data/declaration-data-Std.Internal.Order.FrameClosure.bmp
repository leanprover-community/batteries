eserve suprema. Instances derive `opE` from the structure\nof `EPosts`: `op` itself on the assertion type, a pointwise lift under a function layer, and a\ncomponentwise lift on a product layer. A low-priority default instance ignores the frame. An\ninstance for a custom exception layer takes precedence.","docLink":"./Std/Internal/Order/FrameClosure.html#Lean.Order.FrameOp","kind":"class","line":31,"name":"Lean.Order.FrameOp","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Std/Internal/Order/FrameClosure.lean#L31-L41"}}],"imports":["Std.Internal.Order.OfProp","Std.Internal.Order.PredTrans","Std.Internal.Order.PreservesSup"],"instances":[{"className":"Lean.Order.PreservesSup","name":"Lean.Order.instPreservesSupForallPointwise","typeNames":["Lean.Order.FrameOp.pointwise"]},{"className":"Lean.Order.PreservesSup","name":"Lean.Order.instPreservesSupProdProd","typeNames":["Lean.Order.FrameOp.prod"]},{"className":"Lean.Order.PreservesSup","name":"Lean.Order.instPreservesSupIgnore","typeNames":["Lean.Order.FrameOp.ignore"]},{"className":"Lean.Order.FrameOp","name":"Lean.Order.instFrameOpOfPreservesSup","typeNames":[]},{"className":"Lean.Order.FrameOp","name":"Lean.Order.instFrameOpForallPointwise","typeNames":["Lean.Order.FrameOp.pointwise"]},{"className":"Lean.Order.FrameOp","name":"Lean.Order.instFrameOpProdProd","typeNames":["Prod","Lean.Order.FrameOp.prod"]},{"className":"Lean.Order.FrameOp","name":"Lean.Order.instFrameOpIgnoreOfPreservesSup","typeNames":["Lean.Order.FrameOp.ignore"]}],"name":"Std.Internal.Order.FrameClosure"}