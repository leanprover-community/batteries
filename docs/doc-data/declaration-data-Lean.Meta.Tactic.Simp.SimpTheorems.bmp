/Simp/SimpTheorems.html#Lean.Meta.Origin.fvar","kind":"ctor","line":75,"name":"Lean.Meta.Origin.fvar","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Simp/SimpTheorems.lean#L75-L81"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.Origin.decl\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Origin</span>.<span class=\"name\">decl</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">post</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a> := <a href=\"./Init/Prelude.html#Bool.true\">true</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">inv</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a> := <a href=\"./Init/Prelude.html#Bool.false\">false</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.Origin\">Origin</a></div></div>","info":{"doc":"A global declaration in the environment.","docLink":"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.Origin.decl","kind":"ctor","line":73,"name":"Lean.Meta.Origin.decl","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Simp/SimpTheorems.lean#L73-L74"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.Origin\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Origin</span></a> </span><span class=\"decl_args\"> :</span><div class=\"d