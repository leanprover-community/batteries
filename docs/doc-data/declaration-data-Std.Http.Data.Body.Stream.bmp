lass=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">closeWithError</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">err</span> : <a href=\"./Init/System/IOError.html#IO.Error\">IO.Error</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Closes the channel and records `err` as a terminal error. A subsequent `recv` that would have\nreturned end-of-stream surfaces the error instead; already buffered chunks are still delivered first.\nThis function does not overwrite an existing error.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.closeWithError","kind":"def","line":327,"name":"Std.Http.Body.Stream.closeWithError","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L327-L338"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.closeIfAbandoned\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">closeIfAbandoned</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Closes the channel only if no consumer is currently registered (i.e., the stream\nwas abandoned without being read). If a consumer is waiting, the close is skipped\nso the pending `recv` can still receive data. Returns `true` if the stream was closed.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.closeIfAbandoned","kind":"def","line":312,"name":"Std.Http.Body.Stream.closeIfAbandoned","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L312-L325"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.close\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">close</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Closes the channel.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.close","kind":"def","line":305,"name":"Std.Http.Body.Stream.close","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L305-L310"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.recv\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">recv</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/Chunk.html#Std.Http.Chunk\">Chunk</a>)</span></span></div></div>","info":{"doc":"Receives a chunk from the channel. Blocks until a producer sends one. Returns `none` if the channel\nis closed and no producer is waiting. If the channel was closed with a terminal error\n(via `closeWithError`) after all buffered chunks have been consumed, that error is thrown instead of EOF.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.recv","kind":"def","line":297,"name":"Std.Http.Body.Stream.recv","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L297-L303"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.tryRecvBody\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">tryRecvBody</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/Chunk.html#Std.Http.Chunk\">Chunk</a>)</span>)</span></span></div></div>","info":{"doc":"Non-blocking receive for the `Body` typeclass. Returns `none` when no producer is\nwaiting and the channel is still open, `some (some chunk)` when data is ready,\nor `some none` at end-of-stream (channel closed with no pending producer).\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.tryRecvBody","kind":"def","line":256,"name":"Std.Http.Body.Stream.tryRecvBody","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L256-L269"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.tryRecv\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">tryRecv</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/Chunk.html#Std.Http.Chunk\">Chunk</a>)</span></span></div></div>","info":{"doc":"Attempts to receive a chunk from the channel without blocking.\nReturns `some chunk` only when a producer is already waiting. If the stream has been closed with a\nterminal error, throws that error instead of returning `none`.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.tryRecv","kind":"def","line":244,"name":"Std.Http.Body.Stream.tryRecv","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L244-L254"