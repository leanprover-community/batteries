m.html#Std.Http.Body.instForInContextAsyncStreamChunk","kind":"instance","line":702,"name":"Std.Http.Body.instForInContextAsyncStreamChunk","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L702-L703"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.instForInAsyncStreamChunk\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">instForInAsyncStreamChunk</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Core.html#ForIn\">ForIn</a> <a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a> <a href=\"./Std/Http/Data/Chunk.html#Std.Http.Chunk\">Chunk</a></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.instForInAsyncStreamChunk","kind":"instance","line":699,"name":"Std.Http.Body.instForInAsyncStreamChunk","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L699-L700"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.empty\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">empty</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a></span></div></div>","info":{"doc":"Creates an empty `Stream` body channel (already closed, no data).\n\nPrefer `Body.Empty` when you need a concrete zero-cost type. Use this when the calling\ncontext requires a `Stream` specifically.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.empty","kind":"def","line":687,"name":"Std.Http.Body.empty","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L687-L697"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.fromBytes\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">fromBytes</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">content</span> : <a href=\"./Init/Prelude.html#ByteArray\">ByteArray</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a></span></div></div>","info":{"doc":"Creates a body from a fixed byte array.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.fromBytes","kind":"def","line":678,"name":"Std.Http.Body.fromBytes","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L678-L685"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.stream\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">stream</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">gen</span> : <span class=\"fn\"><a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a> → <span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a></span></div></div>","info":{"doc":"Creates a body from a producer function.\nReturns the stream immediately and runs `gen` in a detached task.\nThe channel is closed when `gen` returns. If `gen` throws, the channel is closed with that terminal\nerror so consumers observe the failure instead of a clean end-of-stream.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.stream","kind":"def","line":659,"name":"Std.Http.Body.stream","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L659-L676"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.interestSelector\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">interestSelector</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Select.html#Std.Async.Selector\">Async.Selector</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Creates a selector that resolves when consumer interest is present.\nReturns `true` when a consumer is waiting, `false` when the channel closes first.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.interestSelector","kind":"def","line":617,"name":"Std.Http.Body.Stream.interestSelector","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L617-L655"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.hasInterest\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">hasInterest</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Returns `true` when a consumer is currently blocked waiting for data.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.hasInterest","kind":"def","line":608,"name":"Std.Http.Body.Stream.hasInterest","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L608-L614"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.send\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">send</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">chunk</span> : <a href=\"./Std/Http/Data/Chunk.html#Std.Http.Chunk\">Chunk</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">incomplete</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a> := <a href=\"./Init/Prelude.html#Bool.false\">false</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Sends a chunk.\n\nIf `incomplete := true`, the chunk is buffered and collapsed with subsequent chunks, and is not\ndelivered to the receiver yet.\nIf `incomplete := false`, any buffered incomplete pieces are collapsed with this chunk and the\nsingle merged chunk is sent.\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.send","kind":"def","line":590,"name":"Std.Http.Body.Stream.send","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L590-L606"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.drain\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Stream</span>.<span class=\"name\">drain</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">m</span> : <span class=\"fn\"><a href=\"./foundational_types.html\">Type</a> → <a href=\"./foundational_types.html\">Type</a></span>}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#Monad\">Monad</a> <span class=\"fn\">m</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.NextChunk\">NextChunk</a> <span class=\"fn\">m</span></span>]</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">stream</span> : <a href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream\">Stream</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">drainLimit</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#UInt64\">UInt64</a></span> := <a href=\"./Init/Prelude.html#Option.none\">none</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">closeStream</span> : <span class=\"fn\"><span class=\"fn\">m</span> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span> := <span class=\"fn\"><a href=\"./Init/Prelude.html#Pure.pure\">pure</a> <a href=\"./Init/Prelude.html#Unit.unit\">(</a><a href=\"./Init/Prelude.html#Unit.unit\">)</a></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">m</span> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Drains all remaining chunks from the stream, discarding their contents.\n\nIf `drainLimit` is given, at most that many bytes are consumed; when the limit is exceeded the\nstream is closed (via `closeStream`) and no error is raised.\n\nWorks in both `Async` (reads until EOF, no cancellation) and `ContextAsync` (also stops if the\ncontext is cancelled).\n","docLink":"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.drain","kind":"def","line":492,"name":"Std.Http.Body.Stream.drain","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Stream.lean#L492-L516"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Stream.html#Std.Http.Body.Stream.readAll\"><span class=\"name\">Std</span>.<span cla