tive\">WPConjunctive</a> <span class=\"fn\">x</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Std/Internal/Order/Heyting.html#Lean.Order.Heyting\">Lean.Order.Heyting</a> <span class=\"fn\">Pred</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">[<span class=\"fn\"><a href=\"./Std/Internal/Order/Heyting.html#Lean.Order.Heyting\">Lean.Order.Heyting</a> <span class=\"fn\">EPred</span></span>]</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">pre₁ </span><span class=\"fn\">pre₂</span> : <span class=\"fn\">Pred</span>}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">post₁ </span><span class=\"fn\">post₂</span> : <span class=\"fn\"><span class=\"fn\">Value</span> → <span class=\"fn\">Pred</span></span>}</span></span>\n</span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">epost₁ </span><span class=\"fn\">epost₂</span> : <span class=\"fn\">EPred</span>}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">h₁</span> : <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦃</a> <span class=\"fn\">pre₁</span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦄</a> <span class=\"fn\">x</span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦃</a> <span class=\"fn\">post₁</span><a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">;</a> <span class=\"fn\">epost₁</span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦄</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">h₂</span> : <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦃</a> <span class=\"fn\">pre₂</span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦄</a> <span class=\"fn\">x</span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦃</a> <span class=\"fn\"><a href=\"./Std/Internal/Order/Heyting.html#Lean.Order.himp\">Lean.Order.himp</a> <span class=\"fn\">post₁</span> <span class=\"fn\">post₂</span></span><a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">;</a> <span class=\"fn\"><a href=\"./Std/Internal/Order/Heyting.html#Lean.Order.himp\">Lean.Order.himp</a> <span class=\"fn\">epost₁</span> <span class=\"fn\">epost₂</span></span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦄</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦃</a> <span class=\"fn\"><a href=\"./Std/Internal/Order/Basic.html#Lean.Order.meet\">Lean.Order.meet</a> <span class=\"fn\">pre₁</span> <span class=\"fn\">pre₂</span></span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦄</a> <span class=\"fn\">x</span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦃</a> <span class=\"fn\"><a href=\"./Std/Internal/Order/Basic.html#Lean.Order.meet\">Lean.Order.meet</a> <span class=\"fn\">post₁</span> <span class=\"fn\">post₂</span></span><a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">;</a> <span class=\"fn\"><a href=\"./Std/Internal/Order/Basic.html#Lean.Order.meet\">Lean.Order.meet</a> <span class=\"fn\">epost₁</span> <span class=\"fn\">epost₂</span></span> <a href=\"./Std/WP/Triple/Basic.html#Std.WP.Triple\">⦄</a></div></div>","info":{"doc":"Modus ponens for two Hoare triple specifications of a program `x`. This theorem separates proofs.\nLet `h₁` establish a basic postcondition `post₁` for `x`, and let `h₂` establish the advanced\npostcondition `post₂` under the assumption `post₁`. Then `mp h₁ h₂` establishes `post₂` for `x`.\n","docLink":"./Std/WP/Triple/Conjunctive.html#Std.WP.Triple.mp","kind":"theorem","line":46,"name":"Std.WP.Triple.mp","sourceLink":"https://github.com/leanprover/lean4/blob/11acb17ec6b07a8f9e9173e6845197929540936b/src/Std/WP/Triple/Conjunctive.lean#L46-L58"}},{"header":"<div 