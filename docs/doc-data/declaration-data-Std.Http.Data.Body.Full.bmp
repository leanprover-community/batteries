/github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Full.lean#L116-L135"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full.tryRecv\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Full</span>.<span class=\"name\">tryRecv</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">full</span> : <a href=\"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full\">Full</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/Chunk.html#Std.Http.Chunk\">Chunk</a>)</span>)</span></span></div></div>","info":{"doc":"Non-blocking receive. `Full` bodies are always in-memory, so data is always\nimmediately available. Returns `some chunk` on first call, `some none` (EOF)\nonce consumed or closed.\n","docLink":"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full.tryRecv","kind":"def","line":108,"name":"Std.Http.Body.Full.tryRecv","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Full.lean#L108-L114"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full.getKnownSize\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Full</span>.<span class=\"name\">getKnownSize</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">full</span> : <a href=\"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full\">Full</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/Body/Length.html#Std.Http.Body.Length\">Length</a>)</span></span></div></div>","info":{"doc":"Returns the known size of the remaining data.\nReturns `some (.fixed n)` with the byte count if not yet consumed, `some (.fixed 0)` otherwise.\n","docLink":"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full.getKnownSize","kind":"def","line":97,"name":"Std.Http.Body.Full.getKnownSize","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Full.lean#L97-L106"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full.isClosed\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Body</span>.<span class=\"name\">Full</span>.<span class=\"name\">isClosed</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">full</span> : <a href=\"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full\">Full</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Async/Basic.html#Std.Async.Async\">Async.Async</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Returns `true` when the body has been closed or consumed.\n","docLink":"./Std/Http/Data/Body/Full.html#Std.Http.Body.Full.isClosed","kind":"def","line":90,"name":"Std.Http.Body.Full.isClosed","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Std/Http/Data/Body/Full.lean#L90-L95"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</s