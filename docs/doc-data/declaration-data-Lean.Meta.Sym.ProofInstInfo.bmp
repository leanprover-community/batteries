{"declarations":[{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.getProofInstInfoOfExpr?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">getProofInstInfoOfExpr?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.SymM\">SymM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.ProofInstInfo\">ProofInstInfo</a>)</span></span></div></div>","info":{"doc":"Returns information about which arguments of the function `e` are proofs or instances, see\n`getProofInstInfo?` and `getProofInstInfoOfFVar?`. Returns `none` if `e` is neither a constant\nnor a local declaration.","docLink":"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.getProofInstInfoOfExpr?","kind":"def","line":107,"name":"Lean.Meta.Sym.getProofInstInfoOfExpr?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/ProofInstInfo.lean#L107-L116"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.getProofInstInfoOfFVar?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">getProofInstInfoOfFVar?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">fvarId</span> : <a href=\"./Lean/Expr.html#Lean.FVarId\">FVarId</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.SymM\">SymM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.ProofInstInfo\">ProofInstInfo</a>)</span></span></div></div>","info":{"doc":"Returns information about the type of the local declaration `fvarId`. It contains information about\nwhich arguments are proofs or instances. Returns `none` if no arguments are proofs or instances.","docLink":"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.getProofInstInfoOfFVar?","kind":"def","line":95,"name":"Lean.Meta.Sym.getProofInstInfoOfFVar?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/ProofInstInfo.lean#L95-L105"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.getProofInstInfo?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">getProofInstInfo?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.SymM\">SymM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.ProofInstInfo\">ProofInstInfo</a>)</span></span></div></div>","info":{"doc":"Returns information about the type signature of `declName`. It contains information about which arguments\nare proofs or instances. Returns `none` if no arguments are proofs or instances.","docLink":"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.getProofInstInfo?","kind":"def","line":83,"name":"Lean.Meta.Sym.getProofInstInfo?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/ProofInstInfo.lean#L83-L93"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.mkProofInstInfo?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">mkProofInstInfo?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.ProofInstInfo\">ProofInstInfo</a>)</span></span></div></div>","info":{"doc":"Analyzes the type signature of `declName` and returns information about which arguments\nare proofs or instances. Returns `none` if no arguments are proofs or instances.","docLink":"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.mkProofInstInfo?","kind":"def","line":74,"name":"Lean.Meta.Sym.mkProofInstInfo?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/ProofInstInfo.lean#L74-L81"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.mkProofInstArgInfo?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">mkProofInstArgInfo?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">xs</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Meta/Sym/SymM.html#Lean.Meta.Sym.ProofInstInfo\">ProofInstInfo</a>)</span></span></div></div>","info":{"doc":"Analyzes whether the given free variables (aka arguments) are proofs or instances.\nReturns `none` if no arguments are proofs or instances.","docLink":"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.mkProofInstArgInfo?","kind":"def","line":55,"name":"Lean.Meta.Sym.mkProofInstArgInfo?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/ProofInstInfo.lean#L55-L72"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.preprocessType\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">preprocessType</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">type</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">zetaReduceLHSOnly </span><span class=\"fn\">zetaDelta</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a> := <a href=\"./Init/Prelude.html#Bool.false\">false</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">num?</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span> := <a href=\"./Init/Prelude.html#Option.none\">none</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Preprocesses types used for pattern matching and unification. It instantiates assigned\nmetavariables first, since a metavariable in a pattern is an opaque constant.\n`num?` is the number of binders that become pattern variables (all if `none`).","docLink":"./Lean/Meta/Sym/ProofInstInfo.html#Lean.Meta.Sym.preprocessType","kind":"def","line":35,"name":"Lean.Meta.Sym.preprocessType","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/ProofInstInfo.lean#L35-L53"}}],"imports":["Lean.Meta.LetToHave","Lean.Meta.Sym.Eta","Lean.Meta.Sym.IsClass","Lean.Meta.Sym.SymM","Lean.Meta.Sym.Util"],"instances":[],"name":"Lean.Meta.Sym.ProofInstInfo"}