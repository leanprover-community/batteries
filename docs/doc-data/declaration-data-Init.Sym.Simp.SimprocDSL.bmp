 each attempt.","docLink":"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischGrind","kind":"def","line":101,"name":"Lean.Parser.Sym.Simp.dischGrind","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/Sym/Simp/SimprocDSL.lean#L101-L107"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischParen\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">dischParen</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Parenthesized discharger expression.","docLink":"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischParen","kind":"def","line":98,"name":"Lean.Parser.Sym.Simp.dischParen","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/Sym/Simp/SimprocDSL.lean#L98-L99"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischNone\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">dischNone</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"No discharge. Only unconditional rewrites will apply.","docLink":"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischNone","kind":"def","line":95,"name":"Lean.Parser.Sym.Simp.dischNone","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/Sym/Simp/SimprocDSL.lean#L95-L96"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischSelf\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">dischSelf</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Recursive simplifier discharge. Calls the full simplifier to prove side conditions.","docLink":"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.dischSelf","kind":"def","line":92,"name":"Lean.Parser.Sym.Simp.dischSelf","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/Sym/Simp/SimprocDSL.lean#L92-L93"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.simprocParen\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">simprocParen</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Parenthesized simproc expression.","docLink":"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.simprocParen","kind":"def","line":87,"name":"Lean.Parser.Sym.Simp.simprocParen","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/Sym/Simp/SimprocDSL.lean#L87-L88"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Sym/Simp/SimprocDSL.html#Lean.Parser.Sym.Simp.orElse\"><span class=\"name\">Le