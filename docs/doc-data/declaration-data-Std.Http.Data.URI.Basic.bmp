src/Std/Http/Data/URI/Basic.lean#L231-L234"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Host\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">Host</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"Host component of a URI, supporting domain names and IP addresses.\n\nReference: https://www.rfc-editor.org/rfc/rfc3986.html#section-3.2.2","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Host","kind":"inductive","line":225,"name":"Std.Http.URI.Host","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L225-L251"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.DomainName.ofString?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">DomainName</span>.<span class=\"name\">ofString?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.DomainName\">DomainName</a></span></div></div>","info":{"doc":"Attempts to create a normalized domain name from a string.\nReturns `none` if the name is empty, longer than 255 characters, ends in a numeric label, or any label\nviolates DNS label constraints.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.DomainName.ofString?","kind":"def","line":209,"name":"Std.Http.URI.DomainName.ofString?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L209-L221"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.DomainName\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">DomainName</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"A domain name represented as a validated, lowercase-normalized string.\nOnly ASCII alphanumeric characters, `-`, `_` and dots are allowed.\nEach label cannot start or end with `-` and is limited to 63 characters, and the last label cannot be\na number.\nInternationalized domain names must be converted to punycode before use.\n\nReference: https://www.rfc-editor.org/rfc/rfc3986.html#section-3.2.2","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.DomainName","kind":"def","line":196,"name":"Std.Http.URI.DomainName","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L196-L205"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.IsValidDomainName\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">IsValidDomainName</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Prop</a></div></div>","info":{"doc":"Proposition that asserts `s` is a valid dot-separated domain name.\nEach label must satisfy `IsValidDomainLabel`, the last label must not be a number (see\n`endsInNumber`), and the full name must be at most 255 characters.\nA single trailing `.` (a fully qualified name such as `example.com.`) adds no label.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.IsValidDomainName","kind":"def","line":185,"name":"Std.Http.URI.IsValidDomainName","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L185-L194"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.endsInNumber\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">endsInNumber</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Checks whether the last label of a dot-separated name is a number: decimal digits, or `0x` followed\nby hex digits. The system resolver reads such a name as an IPv4 address in shorthand (`127.1`,\n`2130706433`, `0x7f.0.0.1`), so it cannot be a domain name.\n\nReference: https://url.spec.whatwg.org/#ends-in-a-number-checker","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.endsInNumber","kind":"def","line":172,"name":"Std.Http.URI.endsInNumber","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L172-L183"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.isValidDomainLabel\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">isValidDomainLabel</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Checks whether a single domain label is valid. A label must be non-empty, contain only ASCII\nalphanumeric characters, `-` and `_`, cannot start or end with `-`, and must be at most 63\ncharacters.\n\n`_` is outside the RFC 1123 host-name syntax but is an RFC 3986 reg-name character, and names such as\ncontainer service names use it.\n\nReferences:\n* https://www.rfc-editor.org/rfc/rfc1034.html#section-3.5\n* https://www.rfc-editor.org/rfc/rfc1123.html#section-2.1","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.isValidDomainLabel","kind":"def","line":153,"name":"Std.Http.URI.isValidDomainLabel","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L153-L170"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.password?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span>.<span class=\"name\">password?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ui</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Returns the decoded password when present, or `none` if absent or decoding fails UTF-8 validation.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.password?","kind":"def","line":144,"name":"Std.Http.URI.UserInfo.password?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L144-L149"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.username?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span>.<span class=\"name\">username?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ui</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Returns the decoded username, or `none` if decoding fails UTF-8 validation.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.username?","kind":"def","line":137,"name":"Std.Http.URI.UserInfo.username?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L137-L142"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.ofStrings\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span>.<span class=\"name\">ofStrings</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">username</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">password</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String\">String</a></span> := <a href=\"./Init/Prelude.html#Option.none\">none</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a></div></div>","info":{"doc":"Builds a `UserInfo` value from raw strings by applying userinfo percent-encoding. A `:` in the\nusername is encoded too, since the first `:` separates it from the password (RFC 3986 §3.2.1).","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.ofStrings","kind":"def","line":128,"name":"Std.Http.URI.UserInfo.ofStrings","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L128-L135"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instBEqUserInfo\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">instBEqUserInfo</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#BEq\">BEq</a> <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instBEqUserInfo","kind":"instance","line":124,"name":"Std.Http.URI.instBEqUserInfo","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L124-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instBEqUserInfo.beq\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">instBEqUserInfo</span>.<span class=\"name\">beq</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a> → <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instBEqUserInfo.beq","kind":"def","line":124,"name":"Std.Http.URI.instBEqUserInfo.beq","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L124-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instReprUserInfo.repr\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">instReprUserInfo</span>.<span class=\"name\">repr</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <a href=\"./Init/Data/Format/Basic.html#Std.Format\">Format</a></span></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instReprUserInfo.repr","kind":"def","line":124,"name":"Std.Http.URI.instReprUserInfo.repr","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L124-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instReprUserInfo\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">instReprUserInfo</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Repr.html#Repr\">Repr</a> <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instReprUserInfo","kind":"instance","line":124,"name":"Std.Http.URI.instReprUserInfo","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L124-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instInhabitedUserInfo\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">instInhabitedUserInfo</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.instInhabitedUserInfo","kind":"instance","line":124,"name":"Std.Http.URI.instInhabitedUserInfo","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L124-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.password\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span>.<span class=\"name\">password</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.EncodedUserInfo\">EncodedUserInfo</a></span></div></div>","info":{"doc":"The optional encoded password.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.password","kind":"def","line":123,"name":"Std.Http.URI.UserInfo.password","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L123-L123"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.username\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span>.<span class=\"name\">username</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">UserInfo</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.EncodedUserInfo\">EncodedUserInfo</a></div></div>","info":{"doc":"The encoded username.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.username","kind":"def","line":118,"name":"Std.Http.URI.UserInfo.username","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L118-L118"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.mk\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.EncodedUserInfo\">Std.Http.URI.EncodedUserInfo</a> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.EncodedUserInfo\">Std.Http.URI.EncodedUserInfo</a></span> → <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\">Std.Http.URI.UserInfo</a></span></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo.mk","kind":"ctor","line":102,"name":"Std.Http.URI.UserInfo.mk","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L102-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">UserInfo</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"User information component containing an encoded username and optional encoded password.\n\nThe stored strings use URI userinfo percent-encoding so parsed URIs can be rendered without\nlosing percent-encoding choices (for example, `%3A` versus `:`).\n\nNote: embedding passwords in URIs is deprecated per RFC 9110 Section 4.2.4. Avoid using the\npassword field in new code, and never include it in logs or error messages.\n\nReference: https://www.rfc-editor.org/rfc/rfc3986.html#section-3.2.1","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.UserInfo","kind":"structure","line":102,"name":"Std.Http.URI.UserInfo","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L102-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Scheme.ofPort\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">Scheme</span>.<span class=\"name\">ofPort</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">port</span> : <a href=\"./Init/Prelude.html#UInt16\">UInt16</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Scheme\">Scheme</a></div></div>","info":{"doc":"Returns the URI scheme for a given port: `\"https\"` for 443, `\"http\"` otherwise.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Scheme.ofPort","kind":"def","line":94,"name":"Std.Http.URI.Scheme.ofPort","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L94-L98"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Scheme.defaultPort\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">Scheme</span>.<span class=\"name\">defaultPort</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">scheme</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Scheme\">Scheme</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt16\">UInt16</a></div></div>","info":{"doc":"Returns the default port number for this URI scheme: 443 for `https`, 80 for everything else.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Scheme.defaultPort","kind":"def","line":88