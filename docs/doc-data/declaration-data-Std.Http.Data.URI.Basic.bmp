etHostIPv4","kind":"def","line":790,"name":"Std.Http.URI.Builder.setHostIPv4","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L790-L794"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Builder.setHost!\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">Builder</span>.<span class=\"name\">setHost!</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Builder\">Builder</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">name</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Builder\">Builder</a></div></div>","info":{"doc":"Sets the host like `setHost?`, panicking if `name` is neither a dotted-quad IPv4 address nor a valid\ndomain name.","docLink":"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Builder.setHost!","kind":"def","line":781,"name":"Std.Http.URI.Builder.setHost!","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Basic.lean#L781-L788"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Builder.setHost?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">Builder</span>.<span class=\"name\">setHost?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">b</span> : <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.URI.Builder\">Builder</a>)</s