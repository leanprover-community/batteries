","line":278,"name":"Lean.Markdown.LinkDestination.extent","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Inline.lean#L278-L282"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.instInhabitedInline\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">instInhabitedInline</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">a✝</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.Inline\">Inline</a> <span class=\"fn\">a✝</span>)</span></span></div></div>","info":{"doc":"","docLink":"./Lean/Data/Markdown/Inline.html#Lean.Markdown.instInhabitedInline","kind":"instance","line":274,"name":"Lean.Markdown.instInhabitedInline","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Inline.lean#L274-L274"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.Inline.entity\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">Inline</span>.<span class=\"name\">entity</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">range</span> : <span class=\"fn\"><span class=\"f