a/Markdown/Inline.html#Lean.Markdown.LinkTarget.destination","kind":"def","line":313,"name":"Lean.Markdown.LinkTarget.destination","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Inline.lean#L313-L318"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget.titleSource?\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">LinkTarget</span>.<span class=\"name\">titleSource?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget\">LinkTarget</a> <span class=\"fn\">s</span></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTitle\">LinkTitle</a> <span class=\"fn\">s</span>)</span></span></span></div></div>","info":{"doc":"The source of the title of the link or image, if it has one.\n\nThis may be that of an inline target, or that of the link reference definition that the reference\nresolved to. References that resolve to external definitions have none.","docLink":"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget.titleSource?","kind":"def","line":302,"name":"Lean.Markdown.LinkTarget.titleSource?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Inline.lean#L302-L311"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget.destinationSource?\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">LinkTarget</span>.<span class=\"name\">destinationSource?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget\">LinkTarget</a> <span class=\"fn\">s</span></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkDestination\">LinkDestination</a> <span class=\"fn\">s</span>)</span></span></span></div></div>","info":{"doc":"The source of the destination of the link or image in the original document.\n\nThis may be that of an inline target's, or that of the reference definition that a label resolved\nto.  A reference that resolved to an external definition has none.","docLink":"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget.destinationSource?","kind":"def","line":291,"name":"Lean.Markdown.LinkTarget.destinationSource?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Inline.lean#L291-L300"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Inline.html#Lean.Markdown.LinkTarget.stop?\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">LinkTarget</span>.<span class=\"name\">stop?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </spa