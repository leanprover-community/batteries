2952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Protocol/H1/Parser.lean#L464-L471"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseObsFoldContinuation\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Protocol</span>.<span class=\"name\">H1</span>.<span class=\"name\">parseObsFoldContinuation</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">limits</span> : <a href=\"./Std/Http/Protocol/H1/Config.html#Std.Http.Protocol.H1.Config\">Config</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Internal/Parsec/ByteArray.html#Std.Internal.Parsec.ByteArray.Parser\">Internal.Parsec.ByteArray.Parser</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Parses the line that continues a field value after an obsolete line folding (`obs-fold = OWS CRLF\nRWS`, RFC 9112 §5.2): the leading whitespace, the field content and the terminating CRLF. Returns the\ncontent without the whitespace around it.","docLink":"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseObsFoldContinuation","kind":"def","line":372,"name":"Std.Http.Protocol.H1.parseObsFoldContinuation","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Protocol/H1/Parser.lean#L372-L382"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseSingleHeader\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Protocol</span>.<span class=\"name\">H1</span>.<span class=\"name\">parseSingleHeader</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">limits</span> : <a href=\"./Std/Http/Protocol/H1/Config.html#Std.Http.Protocol.H1.Config\">Config</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Internal/Parsec/ByteArray.html#Std.Internal.Parsec.ByteArray.Parser\">Internal.Parsec.ByteArray.Parser</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> (<a href=\"./Init/Prelude.html#String\">String</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#String\">String</a>))</span></span></div></div>","info":{"doc":"Parses a single header field line, or returns `none` when it sees the blank line that\nterminates the header section.\n\n```\nfield-line = field-name \":\" OWS field-value OWS CRLF\n```","docLink":"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseSingleHeader","kind":"def","line":356,"name":"Std.Http.Protocol.H1.parseSingleHeader","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Protocol/H1/Parser.lean#L356-L370"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseRequestLineRawVersion\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Protocol</span>.<span class=\"name\">H1</span>.<span class=\"name\">parseRequestLineRawVersion</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">limits</span> : <a href=\"./Std/Http/Protocol/H1/Config.html#Std.Http.Protocol.H1.Config\">Config</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Internal/Parsec/ByteArray.html#Std.Internal.Parsec.ByteArray.Parser\">Internal.Parsec.ByteArray.Parser</a> (<a href=\"./Std/Http/Data/Method.html#Std.Http.Method\">Method</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Std/Http/Data/URI/Basic.html#Std.Http.RequestTarget\">RequestTarget</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Std/Http/Data/Version.html#Std.Http.Version\">Version</a></span>)</span></div></div>","info":{"doc":"Parses a request line and returns the recognized HTTP method and version when available. A higher\nminor version of HTTP/1 is read as HTTP/1.1 (RFC 9110 §6.2).\n\nrequest-line = method SP request-target SP HTTP-version","docLink":"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseRequestLineRawVersion","kind":"def","line":314,"name":"Std.Http.Protocol.H1.parseRequestLineRawVersion","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Protocol/H1/Parser.lean#L314-L322"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseRequestLine\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Protocol</span>.<span class=\"name\">H1</span>.<span class=\"name\">parseRequestLine</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">limits</span> : <a href=\"./Std/Http/Protocol/H1/Config.html#Std.Http.Protocol.H1.Config\">Config</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Internal/Parsec/ByteArray.html#Std.Internal.Parsec.ByteArray.Parser\">Internal.Parsec.ByteArray.Parser</a> <a href=\"./Std/Http/Data/Request.html#Std.Http.Request.Head\">Request.Head</a></span></div></div>","info":{"doc":"Parses a request line and returns a fully-typed `Request.Head`. A higher minor version of HTTP/1 is\nread as HTTP/1.1 (RFC 9110 §6.2).\n`request-line = method SP request-target SP HTTP-version`","docLink":"./Std/Http/Protocol/H1/Parser.html#Std.Http.Protocol.H1.parseRequestLine","kind":"def","line":300,"name":"Std.Http.Protocol.H1.parseRequestLine","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Protocol/H1/Parser.lean#L300-L312"}}],"imports":["Init.Data.String.Lossy","Std.Http.Data","Std.Http.Protocol.H1.Config","Std.Internal.Parsec","Std.Internal.Parsec.ByteArray"],"instances":[],"name":"Std.Http.Protocol.H1.Parser"}