{"declarations":[{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Unicode/CharacterClasses.html#Lean.Markdown.isUnicodeWhitespace\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">isUnicodeWhitespace</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Whether `c` is Unicode whitespace in the sense of CommonMark: a character of the `Zs`\ngeneral category, or a tab, line feed, form feed, or carriage return. The `Zs` category has\nseventeen characters in Unicode 18.0.0.\n","docLink":"./Lean/Data/Markdown/Unicode/CharacterClasses.html#Lean.Markdown.isUnicodeWhitespace","kind":"def","line":796,"name":"Lean.Markdown.isUnicodeWhitespace","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Unicode/CharacterClasses.lean#L796-L808"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Unicode/CharacterClasses.html#Lean.Markdown.isUnicodePunctuation\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">isUnicodePunctuation</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Whether `c` is Unicode punctuation in the sense of CommonMark: a character of the `P`\n\\(punctuation\\) or `S` \\(symbol\\) general categories, per Unicode 18.0.0. This includes the ASCII\npunctuation, the mathematical operators and arrows, currency signs, and emoji, and it excludes\nletters, digits, whitespace, and combining marks.\n","docLink":"./Lean/Data/Markdown/Unicode/CharacterClasses.html#Lean.Markdown.isUnicodePunctuation","kind":"def","line":781,"name":"Lean.Markdown.isUnicodePunctuation","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Unicode/CharacterClasses.lean#L781-L794"}}],"imports":["Init.Data.Char.Basic"],"instances":[],"name":"Lean.Data.Markdown.Unicode.CharacterClasses"}