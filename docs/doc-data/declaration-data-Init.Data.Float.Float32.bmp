r\">Repr</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instReprFloat32","kind":"instance","line":335,"name":"instReprFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L335-L336"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.repr\"><span class=\"name\">Float32</span>.<span class=\"name\">repr</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">prec</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Format/Basic.html#Std.Format\">Std.Format</a></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#Float32.repr","kind":"def","line":332,"name":"Float32.repr","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L332-L333"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instInhabitedFloat32\"><span class=\"name\">instInhabitedFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instInhabitedFloat32","kind":"instance","line":329,"name":"instInhabitedFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L329-L330"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#USize.toFloat32\"><span class=\"name\">USize</span>.<span class=\"name\">toFloat32</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"Obtains a `Float32` whose value is near the given `USize`.\n\nIt will be exactly the value of the given `USize` if such a `Float32` exists. If no such `Float32`\nexists, the returned value will either be the smallest `Float32` that is larger than the given\nvalue, or the largest `Float32` that is smaller than the given value.\n\nThis function has a logical model in terms of `Float32.Model`, but is overridden at runtime with an\nefficient implementation.\n","docLink":"./Init/Data/Float/Float32.html#USize.toFloat32","kind":"def","line":317,"name":"USize.toFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L317-L327"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#UInt64.toFloat32\"><span class=\"name\">UInt64</span>.<span class=\"name\">toFloat32</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#UInt64\">UInt64</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"Obtains a `Float32` whose value is near the given `UInt64`.\n\nIt will be exactly the value of the given `UInt64` if such a `Float32` exists. If no such `Float32`\nexists, the returned value will either be the smallest `Float32` that is larger than the given\nvalue, or the largest `Float32` that is smaller than the given value.\n\nThis function has a logical model in terms of `Float32.Model`, but is overridden at runtime with an\nefficient implementation.\n","docLink":"./Init/Data/Float/Float32.html#UInt64.toFloat32","kind":"def","line":305,"name":"UInt64.toFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L305-L316"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#UInt32.toFloat32\"><span class=\"name\">UInt32</span>.<span class=\"name\">toFloat32</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"Obtains a `Float32` whose value is near the given `UInt32`.\n\nIt will be exactly the value of the given `UInt32` if such a `Float32` exists. If no such `Float32`\nexists, the returned value will either be the smallest `Float32` that is larger than the given\nvalue, or the largest `Float32` that is smaller than the given value.\n\nThis function has a logical model in terms of `Float32.Model`, but is overridden at runtime with an\nefficient implementation.\n","docLink":"./Init/Data/Float/Float32.html#UInt32.toFloat32","kind":"def","line":293,"name":"UInt32.toFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L293-L304"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#UInt16.toFloat32\"><span class=\"name\">UInt16</span>.<span class=\"name\">toFloat32</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#UInt16\">UInt16</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"Obtains the `Float32` whose value is the same as the given `UInt16`. ","docLink":"./Init/Data/Float/Float32.html#UInt16.toFloat32","kind":"def","line":290,"name":"UInt16.toFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L290-L292"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#UInt8.toFloat32\"><span class=\"name\">UInt8</span>.<span class=\"name\">toFloat32</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#UInt8\">UInt8</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"Obtains the `Float32` whose value is the same as the given `UInt8`. ","docLink":"./Init/Data/Float/Float32.html#UInt8.toFloat32","kind":"def","line":287,"name":"UInt8.toFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L287-L289"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instToStringFloat32\"><span class=\"name\">instToStringFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/ToString/Basic.html#ToString\">ToString</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instToStringFloat32","kind":"instance","line":284,"name":"instToStringFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L284-L285"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.frExp\"><span class=\"name\">Float32</span>.<span class=\"name\">frExp</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Data/Int/Basic.html#Int\">Int</a></span></div></div>","info":{"doc":"Splits the given float `x` into a significand/exponent pair `(s, i)` such that `x = s * 2^i` where\n`s ∈ (-1;-0.5] ∪ [0.5; 1)`. Returns an undefined value if `x` is not finite.\n\nThis function does not reduce in the kernel. It is implemented in compiled code by the C function\n`frexp`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.frExp","kind":"opaque","line":275,"name":"Float32.frExp","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L275-L282"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.isInf\"><span class=\"name\">Float32</span>.<span class=\"name\">isInf</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Checks whether a floating-point number is a positive or negative infinite number, but not a finite\nnumber or `NaN`.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C operator `isinf`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.isInf","kind":"def","line":267,"name":"Float32.isInf","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L267-L274"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.isFinite\"><span class=\"name\">Float32</span>.<span class=\"name\">isFinite</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Checks whether a floating-point number is finite, that is, whether it is normal, subnormal, or zero,\nbut not infinite or `NaN`.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C operator `isfinite`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.isFinite","kind":"def","line":259,"name":"Float32.isFinite","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L259-L266"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.isNaN\"><span class=\"name\">Float32</span>.<span class=\"name\">isNaN</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Checks whether a floating point number is a `NaN` (\"not a number\") value.\n\n`NaN` values result from operations that might otherwise be errors, such as dividing zero by zero.\n\nThis function returns `true` if and only if the input is propositionally equal to `Float32.nan`.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C operator `isnan`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.isNaN","kind":"def","line":248,"name":"Float32.isNaN","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L248-L258"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toUSize\"><span class=\"name\">Float32</span>.<span class=\"name\">toUSize</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#USize\">USize</a></span></div></div>","info":{"doc":"Converts a floating-point number to a word-sized unsigned integer.\n\nIf the given `Float32` is non-negative, truncates the value to a positive integer, rounding down and\nclamping to the range of `USize`. Returns `0` if the `Float32` is negative or `NaN`, and returns the\nlargest `USize` value (i.e. `USize.size - 1`) if the float is larger than it.\n\nThis function has a logical model in terms of `Float32.Model`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toUSize","kind":"def","line":236,"name":"Float32.toUSize","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L236-L246"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toUInt64\"><span class=\"name\">Float32</span>.<span class=\"name\">toUInt64</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#UInt64\">UInt64</a></span></div></div>","info":{"doc":"Converts a floating-point number to a 64-bit unsigned integer.\n\nIf the given `Float32` is non-negative, truncates the value to a positive integer, rounding down and\nclamping to the range of `UInt64`. Returns `0` if the `Float32` is negative or `NaN`, and returns\nthe largest `UInt64` value (i.e. `UInt64.size - 1`) if the float is larger than it.\n\nThis function has a logical model in terms of `Float32.Model`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toUInt64","kind":"def","line":225,"name":"Float32.toUInt64","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L225-L235"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toUInt32\"><span class=\"name\">Float32</span>.<span class=\"name\">toUInt32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span></div></div>","info":{"doc":"Converts a floating-point number to a 32-bit unsigned integer.\n\nIf the given `Float32` is non-negative, truncates the value to a positive integer, rounding down and\nclamping to the range of `UInt32`. Returns `0` if the `Float32` is negative or `NaN`, and returns\nthe largest `UInt32` value (i.e. `UInt32.size - 1`) if the float is larger than it.\n\nThis function has a logical model in terms of `Float32.Model`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toUInt32","kind":"def","line":214,"name":"Float32.toUInt32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L214-L224"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toUInt16\"><span class=\"name\">Float32</span>.<span class=\"name\">toUInt16</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#UInt16\">UInt16</a></span></div></div>","info":{"doc":"Converts a floating-point number to a 16-bit unsigned integer.\n\nIf the given `Float32` is non-negative, truncates the value to a positive integer, rounding down and\nclamping to the range of `UInt16`. Returns `0` if the `Float32` is negative or `NaN`, and returns\nthe largest `UInt16` value (i.e. `UInt16.size - 1`) if the float is larger than it.\n\nThis function has a logical model in terms of `Float32.Model`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toUInt16","kind":"def","line":203,"name":"Float32.toUInt16","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L203-L213"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toUInt8\"><span class=\"name\">Float32</span>.<span class=\"name\">toUInt8</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#UInt8\">UInt8</a></span></div></div>","info":{"doc":"Converts a floating-point number to an 8-bit unsigned integer.\n\nIf the given `Float32` is non-negative, truncates the value to a positive integer, rounding down and\nclamping to the range of `UInt8`. Returns `0` if the `Float32` is negative or `NaN`, and returns the\nlargest `UInt8` value (i.e. `UInt8.size - 1`) if the float is larger than it.\n\nThis function has a logical model in terms of `Float32.Model`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toUInt8","kind":"def","line":192,"name":"Float32.toUInt8","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L192-L202"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toString\"><span class=\"name\">Float32</span>.<span class=\"name\">toString</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Converts a floating-point number to a string.\n\nThis function does not reduce in the kernel.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toString","kind":"opaque","line":186,"name":"Float32.toString","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L186-L191"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.decLe\"><span class=\"name\">Float32</span>.<span class=\"name\">decLe</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Decidable\">Decidable</a> (<span class=\"fn\">a</span> <a href=\"./Init/Prelude.html#LE.le\">≤</a> <span class=\"fn\">b</span>)</span></div></div>","info":{"doc":"Compares two floating point numbers for non-strict inequality.\n\nThis function does not reduce in the kernel. It is compiled to the C inequality operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.decLe","kind":"instance","line":178,"name":"Float32.decLe","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L178-L184"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.decLt\"><span class=\"name\">Float32</span>.<span class=\"name\">decLt</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Decidable\">Decidable</a> (<span class=\"fn\">a</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">b</span>)</span></div></div>","info":{"doc":"Compares two floating point numbers for strict inequality.\n\nThis function does not reduce in the kernel. It is compiled to the C inequality operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.decLt","kind":"instance","line":170,"name":"Float32.decLt","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L170-L176"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instBEqFloat32\"><span class=\"name\">instBEqFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#BEq\">BEq</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instBEqFloat32","kind":"instance","line":168,"name":"instBEqFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L168-L168"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.beq\"><span class=\"name\">Float32</span>.<span class=\"name\">beq</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Checks whether two floating-point numbers are equal according to IEEE 754.\n\nFloating-point equality does not correspond with propositional equality. In particular, it is not\nreflexive since `NaN != NaN`, and it is not a congruence because `0.0 == -0.0`, but\n`1.0 / 0.0 != 1.0 / -0.0`.\n\nThis function does not reduce in the kernel. It is compiled to the C equality operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.beq","kind":"def","line":156,"name":"Float32.beq","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L156-L166"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instLEFloat32\"><span class=\"name\">instLEFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#LE\">LE</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instLEFloat32","kind":"instance","line":154,"name":"instLEFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L154-L154"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instLTFloat32\"><span class=\"name\">instLTFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#LT\">LT</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instLTFloat32","kind":"instance","line":153,"name":"instLTFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L153-L153"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instNegFloat32\"><span class=\"name\">instNegFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Neg\">Neg</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instNegFloat32","kind":"instance","line":152,"name":"instNegFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L152-L152"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instDivFloat32\"><span class=\"name\">instDivFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Div\">Div</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instDivFloat32","kind":"instance","line":151,"name":"instDivFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L151-L151"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instMulFloat32\"><span class=\"name\">instMulFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Mul\">Mul</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instMulFloat32","kind":"instance","line":150,"name":"instMulFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L150-L150"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instSubFloat32\"><span class=\"name\">instSubFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Sub\">Sub</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instSubFloat32","kind":"instance","line":149,"name":"instSubFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L149-L149"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instAddFloat32\"><span class=\"name\">instAddFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Add\">Add</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instAddFloat32","kind":"instance","line":148,"name":"instAddFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L148-L148"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toBits\"><span class=\"name\">Float32</span>.<span class=\"name\">toBits</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span></div></div>","info":{"doc":"Bit-for-bit conversion to `UInt32`. Interprets a `Float32` as a `UInt32`, ignoring the numeric value\nand treating the `Float32`'s bit pattern as a `UInt32`.\n\n`Float32`s and `UInt32`s have the same endianness on all supported platforms. IEEE 754 very\nprecisely specifies the bit layout of floats.\n\nThis function is distinct from `Float.toUInt32`, which attempts to preserve the numeric value rather\nthan reinterpreting the bit pattern.\n","docLink":"./Init/Data/Float/Float32.html#Float32.toBits","kind":"def","line":135,"name":"Float32.toBits","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L135-L146"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.ofBits\"><span class=\"name\">Float32</span>.<span class=\"name\">ofBits</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#UInt32\">UInt32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Bit-for-bit conversion from `UInt32`. Interprets a `UInt32` as a `Float32`, ignoring the numeric\nvalue and treating the `UInt32`'s bit pattern as a `Float32`.\n\n`Float32`s and `UInt32`s have the same endianness on all supported platforms. IEEE 754 very\nprecisely specifies the bit layout of floats.\n\nThis function has a logical model in terms of `Float32.Model`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.ofBits","kind":"def","line":123,"name":"Float32.ofBits","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L123-L133"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.le\"><span class=\"name\">Float32</span>.<span class=\"name\">le</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Non-strict inequality of floating-point numbers. Typically used via the `≤` operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.le","kind":"def","line":117,"name":"Float32.le","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L117-L121"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.lt\"><span class=\"name\">Float32</span>.<span class=\"name\">lt</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Strict inequality of floating-point numbers. Typically used via the `<` operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.lt","kind":"def","line":111,"name":"Float32.lt","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L111-L115"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.neg\"><span class=\"name\">Float32</span>.<span class=\"name\">neg</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Negates 32-bit floating-point numbers according to IEEE 754. Typically used via the `-` prefix\noperator.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C negation operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.neg","kind":"def","line":102,"name":"Float32.neg","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L102-L109"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.div\"><span class=\"name\">Float32</span>.<span class=\"name\">div</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Divides 32-bit floating-point numbers according to IEEE 754. Typically used via the `/` operator.\n\nIn Lean, division by zero typically yields zero. For `Float32`, it instead yields either `Inf`,\n`-Inf`, or `NaN`.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C division operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.div","kind":"def","line":92,"name":"Float32.div","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L92-L101"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.mul\"><span class=\"name\">Float32</span>.<span class=\"name\">mul</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Multiplies 32-bit floating-point numbers according to IEEE 754. Typically used via the `*` operator.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C multiplication operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.mul","kind":"def","line":85,"name":"Float32.mul","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L85-L91"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.sub\"><span class=\"name\">Float32</span>.<span class=\"name\">sub</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Subtracts 32-bit floating-point numbers according to IEEE 754. Typically used via the `-` operator.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C subtraction operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.sub","kind":"def","line":78,"name":"Float32.sub","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L78-L84"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.add\"><span class=\"name\">Float32</span>.<span class=\"name\">add</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Adds two 32-bit floating-point numbers according to IEEE 754. Typically used via the `+` operator.\n\nThis function has a logical model in terms of `Float32.Model`. It is compiled to the C addition operator.\n","docLink":"./Init/Data/Float/Float32.html#Float32.add","kind":"def","line":71,"name":"Float32.add","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L71-L77"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.inf\"><span class=\"name\">Float32</span>.<span class=\"name\">inf</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"The special floating-point value `+Inf`, short for positive infinity, used as a result for\noverflowing computations like `1 / 0`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.inf","kind":"def","line":65,"name":"Float32.inf","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L65-L69"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.nan\"><span class=\"name\">Float32</span>.<span class=\"name\">nan</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"The special floating-point value `NaN`, short for “not a number”. This value comes up as the result\nof erroneous computation like `0 / 0`.\n\nComparing any value with `NaN` using `==`, `<`, `≤` results in `false`, including `nan == nan`\nand `nan ≤ nan`. However, comparing with `NaN` using propositional equality will result in `true`\nif and only if the other value is also `NaN`, which means that `nan = nan` is true.\n\nNote: While there are many bit patterns that represent a “not a number” value, they are all equal\nin the logical model of `Float32`, that is, all floating-point values `f : Float32` with `f.isNaN`\nare propositionally equal to `nan`.\n","docLink":"./Init/Data/Float/Float32.html#Float32.nan","kind":"def","line":51,"name":"Float32.nan","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L51-L63"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instNonemptyFloat32\"><span class=\"name\">instNonemptyFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Nonempty\">Nonempty</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instNonemptyFloat32","kind":"instance","line":48,"name":"instNonemptyFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L48-L49"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instDecidableEqFloat32\"><span class=\"name\">instDecidableEqFloat32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#DecidableEq\">DecidableEq</a> <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instDecidableEqFloat32","kind":"instance","line":46,"name":"instDecidableEqFloat32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L46-L46"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#instDecidableEqFloat32.decEq\"><span class=\"name\">instDecidableEqFloat32</span>.<span class=\"name\">decEq</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">x✝ </span><span class=\"fn\">x✝¹</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Decidable\">Decidable</a> (<span class=\"fn\">x✝</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">x✝¹</span>)</span></div></div>","info":{"doc":"","docLink":"./Init/Data/Float/Float32.html#instDecidableEqFloat32.decEq","kind":"def","line":46,"name":"instDecidableEqFloat32.decEq","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L46-L46"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.toModel\"><span class=\"name\">Float32</span>.<span class=\"name\">toModel</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Model/Float32.html#Float32.Model\">Model</a></div></div>","info":{"doc":"Converts a `Float32` into a `Float32.Model`. ","docLink":"./Init/Data/Float/Float32.html#Float32.toModel","kind":"def","line":41,"name":"Float32.toModel","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L41-L41"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32.ofModel\"><span class=\"name\">Float32</span>.<span class=\"name\">ofModel</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Float/Model/Float32.html#Float32.Model\">Float32.Model</a> → <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></span></div></div>","info":{"doc":"Constructs a `Float32` from a `Float32.Model`. ","docLink":"./Init/Data/Float/Float32.html#Float32.ofModel","kind":"ctor","line":14,"name":"Float32.ofModel","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L14-L41"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Data/Float/Float32.html#Float32\"><span class=\"name\">Float32</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"32-bit floating-point numbers.\n\n`Float32` corresponds to the IEEE 754 *binary32* format (`float` in C or `f32` in Rust).\nFloating-point numbers are a finite representation of a subset of the real numbers, extended with\nextra “sentinel” values that represent undefined and infinite results as well as separate positive\nand negative zeroes. Arithmetic on floating-point numbers approximates the corresponding operations\non the real numbers by rounding the results to numbers that are representable, propagating error and\ninfinite values.\n\nFloating-point numbers include [subnormal numbers](https://en.wikipedia.org/wiki/Subnormal_number).\nTheir special values are:\n * `NaN`, which denotes a class of “not a number” values that result from operations such as\n   dividing zero by zero, and\n * `Inf` and `-Inf`, which represent positive and infinities that result from dividing non-zero\n   values by zero.\n\nLike other low-level types, `Float32` is special-cased by the Lean compiler to correspond to the C\n`float` type. From the point of view of Lean's logic, `Float32` is equivalent to `Float32.Model`\n(via the functions `Float32.toModel` and `Float32.ofModel`), which is itself a subtype of `UInt32`.\nSome of the operations on `Float32` are defined in terms of their `Float32.Model` counterparts,\nwhile others are opaque to Lean's kernel.\n","docLink":"./Init/Data/Float/Float32.html#Float32","kind":"structure","line":14,"name":"Float32","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Data/Float/Float32.lean#L14-L41"}}],"imports":["Init.Data.Float.Float","Init.Data.Float.Model.Float32"],"instances":[{"className":"Decidable","name":"instDecidableEqFloat32","typeNames":["Eq"]},{"className":"Nonempty","name":"instNonemptyFloat32","typeNames":["Float32"]},{"className":"Add","name":"instAddFloat32","typeNames":["Float32"]},{"className":"Sub","name":"instSubFloat32","typeNames":["Float32"]},{"className":"Mul","name":"instMulFloat32","typeNames":["Float32"]},{"className":"Div","name":"instDivFloat32","typeNames":["Float32"]},{"className":"Neg","name":"instNegFloat32","typeNames":["Float32"]},{"className":"LT","name":"instLTFloat32","typeNames":["Float32"]},{"className":"LE","name":"instLEFloat32","typeNames":["Float32"]},{"className":"BEq","name":"instBEqFloat32","typeNames":["Float32"]},{"className":"Decidable","name":"Float32.decLt","typeNames":["LT.lt"]},{"className":"Decidable","name":"Float32.decLe","typeNames":["LE.le"]},{"className":"ToString","name":"instToStringFloat32","typeNames":["Float32"]},{"className":"Inhabited","name":"instInhabitedFloat32","typeNames":["Float32"]},{"className":"Repr","name":"instReprFloat32","typeNames":["Float32"]},{"className":"ReprAtom","name":"instReprAtomFloat32","typeNames":["Float32"]},{"className":"HomogeneousPow","name":"instHomogeneousPowFloat32","typeNames":["Float32"]},{"className":"Min","name":"instMinFloat32","typeNames":["Float32"]},{"className":"Max","name":"instMaxFloat32","typeNames":["Float32"]}],"name":"Init.Data.Float.Float32"}