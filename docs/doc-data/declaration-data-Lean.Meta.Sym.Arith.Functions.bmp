relude.html#MonadLiftT\">MonadLiftT</a> <a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <span class=\"fn\">m</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#Monad\">Monad</a> <span class=\"fn\">m</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Lean/Meta/Sym/Arith/MonadCanon.html#Lean.Meta.Sym.Arith.MonadCanon\">MonadCanon</a> <span class=\"fn\">m</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Lean/Meta/Sym/Arith/MonadRing.html#Lean.Meta.Sym.Arith.MonadRing\">MonadRing</a> <span class=\"fn\">m</span></span>]</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">m</span> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Sym/Arith/Functions.html#Lean.Meta.Sym.Arith.getNatSMulFn","kind":"def","line":99,"name":"Lean.Meta.Sym.Arith.getNatSMulFn","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/Arith/Functions.lean#L99-L104"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Arith/Functions.html#Lean.Meta.Sym.Arith.checkedInstsExt\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Arith</span>.<span class=\"name\">checkedInstsExt</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Environment.html#Lean.EnvExtension\">EnvExtension</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Init/System/IO.html#IO.Ref\">IO.Ref</a> <span class=\"fn\">(<a href=\"./Lean/Data/PersistentHashSet.html#Lean.PHashSet\">PHashSet</a> (<a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>))</span>)</span>)</span></span></div></div>","info":{"doc":"The pairs of instances that `checkInst` found definitionally equal, when both are closed and built\nfrom imported constants only. Each `grind` goal initializes the operators of its structures again.\n\nThe state is a reference created with the environment of the imports, so every declaration of the\nfile and all its environment branches share it, while other files, whose imports may differ, have\ntheir own.\n\nThe gain is small: about 1.4% of the elaboration instructions of a `lia` benchmark with the\n`Sym.simp` normalizer, and nothing measurable on `grind`'s ring benchmarks. Reevaluate whether this\ncache pays for its complexity.","docLink":"./Lean/Meta/Sym/Arith/Functions.html#Lean.Meta.Sym.Arith.checkedInstsExt","kind":"opaque","line":28,"name":"Lean.Meta.Sym.Arith.checkedInstsExt","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Sym/Arith/Functions.lean#L28-L41"}}],"imports":["Init.Grind.Ring","Lean.Meta.Sym.Arith.MonadRing","Lean.Meta.Sym.Arith.MonadSemiring"],"instances":[],"name":"Lean.Meta.Sym.Arith.Functions"}