CSimpAttr.html#Lean.Compiler.CSimp.Entry.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">Compiler</span>.<span class=\"name\">CSimp</span>.<span class=\"name\">Entry</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Lean.Name\">Lean.Name</a> → <a href=\"./Init/Prelude.html#Lean.Name\">Lean.Name</a> → <a href=\"./Init/Prelude.html#Lean.Name\">Lean.Name</a> → <a href=\"./Lean/Compiler/CSimpAttr.html#Lean.Compiler.CSimp.Entry\">Lean.Compiler.CSimp.Entry</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Compiler/CSimpAttr.html#Lean.Compiler.CSimp.Entry.mk","kind":"ctor","line":40,"name":"Lean.Compiler.CSimp.Entry.mk","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Compiler/CSimpAttr.lean#L40-L44"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Compiler/CSimpAttr.html#Lean.Compiler.CSimp.Entry\"><span class=\"name\">Lean</span>.<span class=\"name\">Compiler</span>.<span class=\"name\">CSimp</span>.<span class=\"name\">Entry</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"","docLink":"./Lean/Compiler/CSimpAttr.html#Lean.Compiler.CSimp.Entry","kind":"structure","line":40,"name":"Lean.Compiler.CSimp.Entry","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Compiler/CSimpAttr.lean#L40-L44"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Compiler/CSimpAttr.html#Lean.linter.csimpNoncomputable\"><span class=\"name\">Lean</span>.<span class=\"name\">linter</span>.<span class=\"name\">csimpNoncomputable</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Options.html#Lean.Option\">Lean.Option</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Enables the `csimpNoncomputable` linter, which warns when a `@[csimp]` theorem replaces a\ndefinition that is not marked `noncomputable`. A `@[csimp]` theorem only affects code compiled after\nit, so code compiled before it may still call the slow definition; marking the definition\n`noncomputable` turns such uses into errors.\n\nRecursors and structure projections cannot be marked `noncomputable` and are exempt.\n\nThis linter is off by default. It is a member of the `linter.coreInternal` set, so it is enabled\nwhen building Lean itself.","docLink":"./Lean/Compiler/CSimpAttr.html#Lean.linter.csimpNoncomputable","kind":"opaque","line":20,"name":"Lean.linter.csimpNoncomputable","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Compiler/CSimpAttr.lean#L20-L35"}}],"imports":["Lean.Compiler.NoncomputableAttr","Lean.ExtraModUses","Lean.Linter.Init","Lean.ProjFns","Lean.ScopedEnvExtension","Lean.Util.Recognizers"],"instances":[{"className":"Inhabited","name":"Lean.Compiler.CSimp.instInhabitedEntry","typeNames":["Lean.Compiler.CSimp.Entry"]},{"className":"Inhabited","name":"Lean.Compiler.CSimp.instInhabitedState","typeNames":["Lean.Compiler.CSimp.State"]}],"name":"Lean.Compiler.CSimpAttr"}