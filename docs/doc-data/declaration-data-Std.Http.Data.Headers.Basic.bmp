\">Array</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"The normalized connection-option tokens.","docLink":"./Std/Http/Data/Headers/Basic.html#Std.Http.Header.Connection.tokens","kind":"def","line":236,"name":"Std.Http.Header.Connection.tokens","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/Headers/Basic.lean#L236-L236"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/Headers/Basic.html#Std.Http.Header.Connection.mk\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Header</span>.<span class=\"name\">Connection</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">(<span class=\"fn\">tokens</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Init/Prelude.html#String\">String</a></span>) → <span class=\"fn\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">tokens</span>.<a href=\"./Init/Data/Array/Basic.html#Array.all\">all</a></span> <a href=\"./Std/Http/Internal/String.html#Std.Http.Internal.isToken\">Std.Http.Internal.isToken</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <a href=\"./Init/Prelude.html#Bool.true\">true</a> → <a href=\"./Std/Http/Data/Headers/Basic.html#Std.Http.Header.Connection\">Std.Http.Header.Connection</a></span></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/Headers/Basic.html#Std.Http.Header.Connection.mk","kind":"ctor","line":227,"name":"Std.Http.Header.Connection.mk","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/Headers/Basic.lean#L227-L242"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span><span class=\"decl_name\"> <a class=\"break_within\" href=\".