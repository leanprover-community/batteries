er/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Elab/Tactic/Grind/Param.lean#L64-L70"}}],"imports":["Lean.Elab.SyntheticMVars","Lean.Elab.Tactic.Grind.Anchor","Lean.Elab.Tactic.Grind.Basic","Lean.Meta.Tactic.Grind.ForallProp"],"instances":[],"name":"Lean.Elab.Tactic.Grind.Param"}