{"declarations":[{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Util/FVarSubset.html#Lean.Expr.fvarsSubset\"><span class=\"name\">Lean</span>.<span class=\"name\">Expr</span>.<span class=\"name\">fvarsSubset</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Returns true if the free variables in `a` are subset of the free variables in `b`.","docLink":"./Lean/Util/FVarSubset.html#Lean.Expr.fvarsSubset","kind":"def","line":16,"name":"Lean.Expr.fvarsSubset","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Util/FVarSubset.lean#L16-L27"}}],"imports":["Lean.Util.CollectFVars","Lean.Util.FindExpr"],"instances":[],"name":"Lean.Util.FVarSubset"}