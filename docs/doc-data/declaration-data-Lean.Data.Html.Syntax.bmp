an#L143-L159"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Html/Syntax.html#Lean.Html.Syntax.decodeCharacterReferences\"><span class=\"name\">Lean</span>.<span class=\"name\">Html</span>.<span class=\"name\">Syntax</span>.<span class=\"name\">decodeCharacterReferences</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ref</span> : <a href=\"./Init/Prelude.html#Lean.TSyntax\">TSyntax</a> <span class=\"fn\">`str</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/CoreM.html#Lean.Core.CoreM\">CoreM</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Decodes HTML character references in `ref`, leaving other characters unchanged. ","docLink":"./Lean/Data/Html/Syntax.html#Lean.Html.Syntax.decodeCharacterReferences","kind":"def","line":125,"name":"Lean.Html.Syntax.decodeCharacterReferences","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Data/Html/Syntax.lean#L125-L139"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Html/Syntax.html#Lean.Html.Syntax.decodeCharacterReferenceAt\"><span class=\"name\">Lean</span>.<span class=\"name\">Html</span>.<span class=\"name\">Syntax</span>.<span class=\"name\">decodeCharacterReferenceAt</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">i</span> : <a href=\"./Init/Prelude.html#String.Pos.Raw\">String.Pos.Raw</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">refAt</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#String.Pos.Raw\">String.