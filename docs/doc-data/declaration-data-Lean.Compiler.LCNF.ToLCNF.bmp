{"declarations":[{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Compiler/LCNF/ToLCNF.html#Lean.Compiler.LCNF.ToLCNF.toLCNF\"><span class=\"name\">Lean</span>.<span class=\"name\">Compiler</span>.<span class=\"name\">LCNF</span>.<span class=\"name\">ToLCNF</span>.<span class=\"name\">toLCNF</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">e </span><span class=\"fn\">eType</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Compiler/LCNF/CompilerM.html#Lean.Compiler.LCNF.CompilerM\">CompilerM</a> <span class=\"fn\">(<a href=\"./Lean/Compiler/LCNF/Basic.html#Lean.Compiler.LCNF.Code\">Code</a> <a href=\"./Lean/Compiler/LCNF/Basic.html#Lean.Compiler.LCNF.Purity.pure\">Purity.pure</a>)</span></span></div></div>","info":{"doc":"Put the given expression in `LCNF`.\n\n- Nested proofs are replaced with `lcProof`-applications.\n- Eta-expand applications of declarations that satisfy `shouldEtaExpand`.\n- Put computationally relevant expressions in A-normal form.\n","docLink":"./Lean/Compiler/LCNF/ToLCNF.html#Lean.Compiler.LCNF.ToLCNF.toLCNF","kind":"def","line":588,"name":"Lean.Compiler.LCNF.ToLCNF.toLCNF","sourceLink":"https://github.com/leanprover/lean4/blob/c29b6dda4f7c20e3eeaa717c4e565663c5cfa364/src/Lean/Compiler/LCNF/ToLCNF.lean#L588-L1033"}}],"imports":["Init.Data.Format.Macro","Init.Omega","Lean.Compiler.CSimpAttr","Lean.Compiler.ImplementedByAttr","Lean.Compiler.LCNF.Bind","Lean.Compiler.LCNF.Util","Lean.Compiler.NeverExtractAttr","Lean.Compiler.NoncomputableAttr","Lean.Meta.AppBuilder","Lean.Meta.CasesInfo","Lean.Meta.WHNF","Lean.OriginalConstKind"],"instances":[],"name":"Lean.Compiler.LCNF.ToLCNF"}