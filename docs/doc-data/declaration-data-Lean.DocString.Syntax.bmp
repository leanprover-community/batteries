t/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#String\">String</a></div></div>","info":{"doc":"Escapes `value` so that `getVersoImageAlt` reads it back unchanged.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.escapeVersoImageAlt","kind":"def","line":243,"name":"Lean.Doc.escapeVersoImageAlt","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L243-L244"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.escapeVersoLinkUrl\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">escapeVersoLinkUrl</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">value</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#String\">String</a></div></div>","info":{"doc":"Escapes `value` so that `getVersoLinkUrl` reads it back unchanged.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.escapeVersoLinkUrl","kind":"def","line":240,"name":"Lean.Doc.escapeVersoLinkUrl","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L240-L241"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.versoCodeBoundarySpaces\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">versoCodeBoundarySpaces</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">str</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Whether `str` begins and ends with a space and contains a character other than a space.\n\nIn a code element, this sequence denotes the content with a space removed from each end. The parser\nrecords those two spaces as whitespace rather than content.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.versoCodeBoundarySpaces","kind":"def","line":204,"name":"Lean.Doc.versoCodeBoundarySpaces","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L204-L211"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.longestBacktickRun\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">longestBacktickRun</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">str</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"The length of the longest run of backticks in `str`. A delimiter of inline code, and the fence of a\ncode block, is longer than every run of backticks in the content it surrounds.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.longestBacktickRun","kind":"def","line":190,"name":"Lean.Doc.longestBacktickRun","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L190-L202"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoCodeBlock\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoCodeBlock</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"Code block content in a Verso document, with one `versoCodeLine` token per source line. The code\nblock's indentation is whitespace between tokens. Use `VersoCodeBlock.view` or\n`TSyntax.getVersoCodeBlock` to decode it to a string.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.VersoCodeBlock","kind":"def","line":183,"name":"Lean.Doc.VersoCodeBlock","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L183-L188"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoCodeLine\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoCodeLine</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"A single source line of code content in a Verso document, inside inline code or a code block. Only\nindentation that is semantically part of the line of code is included in the atom, while\nindentation of a code block or docstring as a whole is part of the tokens' whitespace.\n\nUse `VersoCodeLine.view` or `TSyntax.getVersoCodeLine` to decode the line to a string.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.VersoCodeLine","kind":"def","line":174,"name":"Lean.Doc.VersoCodeLine","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L174-L181"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoCode\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoCode</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"Inline code content in a Verso document, with one `versoCodeLine` token per source line. Use\n`VersoCode.view` or `TSyntax.getVersoCode` to decode it to a string.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.VersoCode","kind":"def","line":168,"name":"Lean.Doc.VersoCode","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L168-L172"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoImageAlt\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoImageAlt</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"The alternate text of an image in a Verso document. Use `VersoImageAlt.view` or\n`TSyntax.getVersoImageAlt` to decode the alternate text to a string.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.VersoImageAlt","kind":"def","line":162,"name":"Lean.Doc.VersoImageAlt","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L162-L166"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoLinkRefUrl\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoLinkRefUrl</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"The URL that a link reference definition provides in a Verso document. Use\n`VersoLinkRefUrl.view` or `TSyntax.getVersoLinkRefUrl` to decode the URL to a string.","docLink":"./Lean/DocStri