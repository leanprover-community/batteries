Lean.Doc.VersoDelimiter","kind":"def","line":1019,"name":"Lean.Doc.VersoDelimiter","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L1019-L1032"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoBlock\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoBlock</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"A block-level element of a Verso document, such as a paragraph, a list, or a code block.\n\nUse `VersoBlock.view` to inspect it.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.VersoBlock","kind":"def","line":1012,"name":"Lean.Doc.VersoBlock","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L1012-L1017"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.VersoInline\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">VersoInline</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"An inline element of a Verso document, such as text, emphasis, or a link.\n\nUse `VersoInline.view` to inspect it.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.VersoInline","kind":"def","line":1005,"name":"Lean.Doc.VersoInline","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L1005-L1010"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.document\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">document</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A Verso document, which is a sequence of blocks.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.document","kind":"def","line":992,"name":"Lean.Doc.Parser.document","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L992-L994"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.block\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">block</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Any block element.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.block","kind":"def","line":988,"name":"Lean.Doc.Parser.block","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L988-L989"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.command\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">command</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A block-level command, which invokes an extension during documentation processing.\n\nThe `NAME` is an identifier that determines which command is being used, akin to a function name.\nEach of the `ARGS` may have the following forms:\n* A value, which is a string literal, natural number, or identifier\n* A named argument, of the form `(NAME := VALUE)`\n* A flag, of the form `+NAME` or `-NAME`","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.command","kind":"def","line":974,"name":"Lean.Doc.Parser.Block.command","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L974-L984"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.metadata_block\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">metadata_block</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Metadata for the preceding header.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.metadata_block","kind":"def","line":969,"name":"Lean.Doc.Parser.Block.metadata_block","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L969-L973"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.footnote_ref\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">footnote_ref</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A footnote definition.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.footnote_ref","kind":"def","line":964,"name":"Lean.Doc.Parser.Block.footnote_ref","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L964-L968"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.link_ref\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">link_ref</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A named URL that can be used in links and images.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.link_ref","kind":"def","line":959,"name":"Lean.Doc.Parser.Block.link_ref","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L959-L963"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.header\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">header</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A header\n\nHeaders must be correctly nested to form a tree structure. The first header in a document must\nstart with `#`, and subsequent headers must have at most one more `#` than the preceding header.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.header","kind":"def","line":951,"name":"Lean.Doc.Parser.Block.header","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L951-L958"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.directive\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">directive</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A _directive_, which is an extension to the Verso language in block position. The contents of a\ndirective are written in Verso syntax.\n\nDirectives have the following syntax:\n```\n:::NAME ARGS*\nCONTENT*\n:::\n```\n\nThe `NAME` is an identifier that determines which directive is being used, akin to a function name.\nEach of the `ARGS` may have the following forms:\n* A value, which is a string literal, natural number, or identifier\n* A named argument, of the form `(NAME := VALUE)`\n* A flag, of the form `+NAME` or `-NAME`\n\nThe `CONTENT` is a sequence of block content. Directives may be nested by using more colons in\nthe outer directive. For example:\n```\n::::outer +flag (arg := 5)\nA paragraph.\n:::inner \"label\"\n* 1\n* 2\n:::\n::::\n```","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.directive","kind":"def","line":919,"name":"Lean.Doc.Parser.Block.directive","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L919-L950"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.codeblock\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">codeblock</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A code block that contains literal code. The contents of a code block are not written in Verso\nsyntax.\n\nCode blocks have the following syntax:\n````\n```(NAME ARGS*)?\nCONTENT\n```\n````\n\n`CONTENT` is a literal string. If the `CONTENT` contains a sequence of three or more backticks, then\nthe opening and closing ` ``` ` (called _fences_) must have more backticks than the longest\nsequence in `CONTENT`. Additionally, the opening and closing fences must have the same number of\nbackticks.\n\nIf `NAME` and `ARGS` are not provided, then the code block represents literal text. If provided, the\n`NAME` is an identifier that selects an interpretation of the block. Unlike Markdown, this name is\nnot necessarily the language in which the code is written, though many custom code blocks are, in\npractice, named after the language that they contain. `NAME` is more akin to a function name that\ndetermines the interpretation of the code block's contents. Each of the `ARGS` may have the\nfollowing forms:\n* A value, which is a string literal, natural number, or identifier\n* A named argument, of the form `(NAME := VALUE)`\n* A flag, of the form `+NAME` or `-NAME`\n\nThe `CONTENT` is interpreted according to the indentation of the fences. If the fences are indented\n`n` spaces, then `n` spaces are removed from the start of each line of `CONTENT`.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.codeblock","kind":"def","line":887,"name":"Lean.Doc.Parser.Block.codeblock","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L887-L917"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.blockquote\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">blockquote</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A quotation, which contains a sequence of blocks that are at least as indented as the `>`.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.blockquote","kind":"def","line":882,"name":"Lean.Doc.Parser.Block.blockquote","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L882-L886"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.dl\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">dl</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Description list","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.dl","kind":"def","line":879,"name":"Lean.Doc.Parser.Block.dl","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L879-L881"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.ol\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">ol</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Ordered list","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.ol","kind":"def","line":876,"name":"Lean.Doc.Parser.Block.ol","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L876-L878"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.ul\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">ul</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Unordered List","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.ul","kind":"def","line":873,"name":"Lean.Doc.Parser.Block.ul","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L873-L875"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.para\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Block</span>.<span class=\"name\">para</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Paragraph","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Block.para","kind":"def","line":870,"name":"Lean.Doc.Parser.Block.para","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L870-L872"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.DescItem.item\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">DescItem</span>.<span class=\"name\">item</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A description of an item","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.DescItem.item","kind":"def","line":862,"name":"Lean.Doc.Parser.DescItem.item","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L862-L864"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.ListItem.item\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">ListItem</span>.<span class=\"name\">item</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A list item","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.ListItem.item","kind":"def","line":854,"name":"Lean.Doc.Parser.ListItem.item","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L854-L856"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.inline\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">inline</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Any inline element.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.inline","kind":"def","line":777,"name":"Lean.Doc.Parser.inline","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L777-L778"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.role\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">role</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A _role_ is an extension to the Verso document language in an inline position.\n\nText is given a role using the following syntax: `{NAME ARGS*}[CONTENT]`. The `NAME` is an\nidentifier that determines which role is being used, akin to a function name. Each of the `ARGS` may\nhave the following forms:\n* A value, which is a string literal, natural number, or identifier\n* A named argument, of the form `(NAME := VALUE)`\n* A flag, of the form `+NAME` or `-NAME`\n\nThe `CONTENT` is a sequence of inline content. If there is only one piece of content and it has\nbeginning and ending delimiters (e.g. code literals, links, or images, but not ordinary text), then\nthe `[` and `]` may be omitted. In particular, `` {NAME ARGS*}`x` `` is equivalent to\n``{NAME ARGS*}[`x`]``.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.role","kind":"def","line":757,"name":"Lean.Doc.Parser.Inline.role","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L757-L773"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.linebreak\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">linebreak</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.linebreak","kind":"def","line":756,"name":"Lean.Doc.Parser.Inline.linebreak","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L756-L756"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.footnote\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">footnote</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A footnote use site.\n\nFootnotes must be defined elsewhere using the `[^NAME]: TEXT` syntax.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.footnote","kind":"def","line":749,"name":"Lean.Doc.Parser.Inline.footnote","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L749-L755"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.image\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">image</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"An image, with alternate text and a URL.\n\nThe alternate text is a plain string, rather than Verso markup.\n\nThe image URL may either be a concrete URL (written in parentheses) or a named URL (written in\nsquare brackets).","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.image","kind":"def","line":739,"name":"Lean.Doc.Parser.Inline.image","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L739-L748"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.link\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">link</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"A link. The link's target may either be a concrete URL (written in parentheses) or a named URL\n(written in square brackets).","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.link","kind":"def","line":733,"name":"Lean.Doc.Parser.Inline.link","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L733-L738"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.display_math\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">display_math</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Display-mode mathematical notation","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.display_math","kind":"def","line":730,"name":"Lean.Doc.Parser.Inline.display_math","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L730-L732"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.inline_math\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">inline_math</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Inline mathematical notation (equivalent to LaTeX's `$` notation)","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.inline_math","kind":"def","line":727,"name":"Lean.Doc.Parser.Inline.inline_math","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L727-L729"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.code\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">code</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Literal code.\n\nCode may begin with any non-zero number of backticks. It must be terminated with the same number,\nand it may not contain a sequence of backticks that is at least as long as its starting or ending\ndelimiters.\n\nIf the first and last characters are space, and it contains at least one non-space character, then\nthe resulting string has a single space stripped from each end. Thus, ``` `` `x `` ``` represents\n``\"`x\"``, not ``\" `x \"``.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.code","kind":"def","line":714,"name":"Lean.Doc.Parser.Inline.code","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L714-L726"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.bold\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">bold</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Bold emphasis.\n\nA single `*` suffices to make text bold. Use `_` for emphasis.\n\nBold text may be nested by using longer sequences of `*` for the outer delimiters.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.bold","kind":"def","line":705,"name":"Lean.Doc.Parser.Inline.bold","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L705-L713"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.emph\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">emph</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"Emphasis, often rendered as italics.\n\nEmphasis may be nested by using longer sequences of `_` for the outer delimiters.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.emph","kind":"def","line":698,"name":"Lean.Doc.Parser.Inline.emph","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L698-L704"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.text\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Inline</span>.<span class=\"name\">text</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.Inline.text","kind":"def","line":697,"name":"Lean.Doc.Parser.Inline.text","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L697-L697"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.directiveDelimiter\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">directiveDelimiter</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The sequence of `:` characters that delimits a directive.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.directiveDelimiter","kind":"def","line":588,"name":"Lean.Doc.Parser.directiveDelimiter","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L588-L590"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.displayMathMarker\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">displayMathMarker</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The `$` that introduces inline mathematical notation. `$` begins an antiquotation, so a quotation\nsplices this atom in as `$m:inlineMathMarker`.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.displayMathMarker","kind":"def","line":583,"name":"Lean.Doc.Parser.displayMathMarker","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L583-L585"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.inlineMathMarker\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">inlineMathMarker</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The `$` that introduces inline mathematical notation. `$` begins an antiquotation, so a quotation\nsplices this atom in as `$m:inlineMathMarker`.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.inlineMathMarker","kind":"def","line":575,"name":"Lean.Doc.Parser.inlineMathMarker","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L575-L580"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.codeBlockFence\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">codeBlockFence</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The fence that surrounds a code block. Longer fences allow more backticks in the content.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.codeBlockFence","kind":"def","line":568,"name":"Lean.Doc.Parser.codeBlockFence","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L568-L572"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.codeDelimiter\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">codeDelimiter</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The sequence of backticks that delimits inline code. Longer delimiters allow backticks in the\ncontent.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.codeDelimiter","kind":"def","line":560,"name":"Lean.Doc.Parser.codeDelimiter","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L560-L565"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.boldDelimiter\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">boldDelimiter</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The sequence of `*` characters that delimits bold text.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.boldDelimiter","kind":"def","line":555,"name":"Lean.Doc.Parser.boldDelimiter","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L555-L557"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Syntax.html#Lean.Doc.Parser.emphDelimiter\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">emphDelimiter</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.Parser\">Parser.Parser</a></div></div>","info":{"doc":"The run of `_` characters that delimits emphasis.","docLink":"./Lean/DocString/Syntax.html#Lean.Doc.Parser.emphDelimiter","kind":"def","line":550,"name":"Lean.Doc.Parser.emphDelimiter","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Syntax.lean#L550-L552"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Synt