r/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L55-L55"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorems.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorems</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Lean/Meta/DiscrTree/Types.html#Lean.Meta.DiscrTree\">Lean.Meta.DiscrTree</a> <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Lean.Meta.Sym.Simp.Theorem</a></span> →\n  <span class=\"fn\"><a href=\"./Lean/Meta/DiscrTree/Types.html#Lean.Meta.DiscrTree\">Lean.Meta.DiscrTree</a> <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Lean.Meta.Sym.Simp.Theorem</a></span> → <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorems\">Lean.Meta.Sym.Simp.Theorems</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorems.mk","kind":"ctor","line":53,"name":"Lean.Meta.Sym.Simp.Theorems.mk","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L53-L58"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorems\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorems</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"Collection of simplification theorems available to the simplifier.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorems","kind":"structure","line":53,"name":"Lean.Meta.Sym.Simp.Theorems","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L53-L58"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.instBEqTheorem\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">instBEqTheorem</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#BEq\">BEq</a> <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.instBEqTheorem","kind":"instance","line":50,"name":"Lean.Meta.Sym.Simp.instBEqTheorem","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L50-L51"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.instInhabitedTheorem\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">instInhabitedTheorem</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.instInhabitedTheorem","kind":"instance","line":48,"name":"Lean.Meta.Sym.Simp.instInhabitedTheorem","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L48-L48"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.fallback\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">fallback</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"If `true`, the theorem is tried only when no other theorem rewrites the term.\nUsed for the unfolding theorem `f.eq_def` of a definition `f` provided as a `Sym.simp`\nparameter: the equational theorems of `f` take precedence. See `Theorems.rewrite`.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.fallback","kind":"def","line":47,"name":"Lean.Meta.Sym.Simp.Theorem.fallback","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L47-L47"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.rhsVarMask\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">rhsVarMask</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"Bitmask of the pattern variables that occur in `rhs`: bit `i` is set iff pattern\nvariable `i` occurs in `rhs`. `Theorem.rewrite` uses it to detect hypothesis proofs that\nbecome part of the resulting term and must consequently be maximally shared.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.rhsVarMask","kind":"def","line":41,"name":"Lean.Meta.Sym.Simp.Theorem.rhsVarMask","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L41-L41"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.perm\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">perm</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"If `true`, the theorem is a permutation rule (e.g., `x + y = y + x`).\nRewriting is only applied when the result is strictly less than the input\n(using `acLt`), preventing infinite loops.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.perm","kind":"def","line":37,"name":"Lean.Meta.Sym.Simp.Theorem.perm","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L37-L37"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.rhs\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">rhs</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></div></div>","info":{"doc":"Right-hand side of the equation.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.rhs","kind":"def","line":33,"name":"Lean.Meta.Sym.Simp.Theorem.rhs","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L33-L33"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.pattern\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">pattern</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Meta/Sym/Pattern.html#Lean.Meta.Sym.Pattern\">Pattern</a></div></div>","info":{"doc":"Precomputed pattern extracted from the theorem's type for efficient matching.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.pattern","kind":"def","line":31,"name":"Lean.Meta.Sym.Simp.Theorem.pattern","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L31-L31"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.expr\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">expr</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem\">Theorem</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></div></div>","info":{"doc":"The theorem expression, typically `Expr.const declName` for a named theorem.","docLink":"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.expr","kind":"def","line":29,"name":"Lean.Meta.Sym.Simp.Theorem.expr","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/Sym/Simp/Theorems.lean#L29-L29"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Sym/Simp/Theorems.html#Lean.Meta.Sym.Simp.Theorem.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Sym</span>.<span class=\"name\">Simp</span>.<span class=\"name\">Theorem</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Expr.html#Lean.Expr\">Lean.Expr</a> → <span class=\"fn\"><a href=\"./Lean/Meta/Sym/Pattern.html#Lean.Meta.Sym.Pattern\">Lean.Meta.Sym.Pattern</a> → <span cla