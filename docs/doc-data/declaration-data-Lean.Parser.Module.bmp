lCommandParserFn</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">ParserFn</a></div></div>","info":{"doc":"","docLink":"./Lean/Parser/Module.html#Lean.Parser.topLevelCommandParserFn","kind":"def","line":145,"name":"Lean.Parser.topLevelCommandParserFn","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Parser/Module.lean#L145-L149"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Parser/Module.html#Lean.Parser.isTerminalCommand\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">isTerminalCommand</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#Lean.Syntax\">Syntax</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"","docLink":"./Lean/Parser/Module.html#Lean.Parser.isTerminalCommand","kind":"def","line":135,"name":"Lean.Parser.isTerminalCommand","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Parser/Module.lean#L135-L136"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Parser/Module.html#Lean.Parser.parseHeader\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">parseHeader</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">inputCtx</span> : <a href=\"./Lean/Parser/Types.html#Lean.Parser.InputContext\">InputContext</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">startPos</span> : <a href=\"./Init/Prelude.html#String.Pos.Raw\">String.Pos.Raw</a> := <span class=\"fn\">0</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/System/IO.html#IO\">IO</a> (<a href=\"./Init/Prelude.html#Lean.TSyntax\">TSyntax</a> <span class=\"fn\">`Lean.Parser.Module.header</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/Parser/Module.html#Lean.Parser.ModuleParserState\">ModuleParserState</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/Message.html#Lean.MessageLog\">MessageLog</a>)</span></div></div>","info":{"doc":"Parses a module header starting at `startPos` (default: `0`), bounded by `inputCtx.endPos`.\n\n`startPos` must be a valid UTF-8 byte position in `inputCtx.inputString` at or before\n`inputCtx.endPos`. Compute it after any line-ending normalization by `mkInputContext`.\nSyntax offsets refer to this string; diagnostic positions use `inputCtx.fileMap`.\n\nPass the returned parser state to `parseCommand` to continue parsing the same region.","docLink":"./Lean/Parser/Module.html#Lean.Parser.parseHeader","kind":"def","line":76,"name":"Lean.Parser.parseHeader","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Parser/Module.lean#L76-L128"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Parser/Module.html#Lean.Parser.instInhabitedModuleParserState\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">instInhabitedModuleParserState</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Lean/Parser/Module.html#Lean.Parser.ModuleParserState\">ModuleParserState</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Parser/Module.html#Lean.Parser.instInhabitedModuleParserState","kind":"instance","line":37,"name":"Lean.Parser.instInhabitedModuleParserState","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Parser/Module.lean#L37-L37"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Parser/Module.html#Lean.Parser.ModuleParserState.leadingStartPos?\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">ModuleParserState</span>.<span class=\"name\">leadingStartPos?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Parser/Module.html#Lean.Parser.ModuleParserState\">ModuleParserState</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String.Pos.Raw\">String.Pos.Raw</a></span></div></div>","info":{"doc":"Start of the initial whitespace to associate with the first token, or `none` if it has already\nbeen associated or should be discarded. When constructing a state directly for an embedded region,\nuse `some` of the region's start position to retain its initial whitespace.","docLink":"./Lean/Parser/Module.html#Lean.Parser.ModuleParserState.leadingStartPos?","kind":"def","line":36,"name":"Lean.Parser.ModuleParserState.leadingStartPos?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Parser/Module.lean#L36-L36"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Parser/Module.html#Lean.Parser.ModuleParserState.recovering\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">ModuleParserState</span>.<span class=\"name\">recovering</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Parser/Module.html#Lean.Parser.Modu