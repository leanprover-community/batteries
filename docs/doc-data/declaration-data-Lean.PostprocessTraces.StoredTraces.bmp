ref=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.postprocess\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">StoredTrace</span>.<span class=\"name\">postprocess</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">t</span> : <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">post</span> : <a href=\"./Lean/PostprocessTraces/Basic.html#Lean.PostprocessTraces.TracePostprocessor\">TracePostprocessor</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/CoreM.html#Lean.Core.CoreM\">CoreM</a> <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a></span></div></div>","info":{"doc":"Applies a postprocessor to every trace message of the stored trace, dropping messages whose\nroots were all removed.\n","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.postprocess","kind":"def","line":112,"name":"Lean.PostprocessTraces.StoredTrace.postprocess","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L112-L117"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.trees\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">StoredTrace</span>.<span class=\"name\">trees</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">t</span> : <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/PostprocessTraces/Basic.html#Lean.PostprocessTraces.TraceTree\">TraceTree</a></span></div></div>","info":{"doc":"All trace trees of the stored trace, across all of its messages. ","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.trees","kind":"def","line":105,"name":"Lean.PostprocessTraces.StoredTrace.trees","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L105-L110"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.storeTraces\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">storeTraces</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">t</span> : <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/CoreM.html#Lean.Core.CoreM\">CoreM</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Stores `t` under the declaration `declName`, overwriting any previously stored trace. ","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.storeTraces","kind":"def","line":99,"name":"Lean.PostprocessTraces.storeTraces","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L99-L101"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.findStoredTrace\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">findStoredTrace</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/CoreM.html#Lean.Core.CoreM\">CoreM</a> <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a></span></div></div>","info":{"doc":"Returns the trace stored under the declaration `declName`. This is the implementation of the\ndeclarations created by `store_traces_as`; the trace data is only available in the file that\nstored it.\n","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.findStoredTrace","kind":"def","line":88,"name":"Lean.PostprocessTraces.findStoredTrace","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L88-L97"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.allStoredTraces\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">allStoredTraces</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">env</span> : <a href=\"./Lean/Environment.html#Lean.Environment\">Environment</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> (<a href=\"./Init/Prelude.html#Lean.Name\">Name</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a>)</span></div></div>","info":{"doc":"The names of all traces stored in the current file, with their stored traces. ","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.allStoredTraces","kind":"def","line":84,"name":"Lean.PostprocessTraces.allStoredTraces","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L84-L86"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.findStoredTrace?\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">findStoredTrace?</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">env</span> : <a href=\"./Lean/Environment.html#Lean.Environment\">Environment</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a></span></div></div>","info":{"doc":"Returns the trace stored under the declaration `declName`, if any. ","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.findStoredTrace?","kind":"def","line":80,"name":"Lean.PostprocessTraces.findStoredTrace?","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L80-L82"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.instInhabitedStoredTrace\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">instInhabitedStoredTrace</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a></span></div></div>","info":{"doc":"","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.instInhabitedStoredTrace","kind":"instance","line":75,"name":"Lean.PostprocessTraces.instInhabitedStoredTrace","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L75-L75"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.messages\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">StoredTrace</span>.<span class=\"name\">messages</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">StoredTrace</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/Message.html#Lean.Message\">Message</a></span></div></div>","info":{"doc":"The stored trace messages: one message per source range inside the traced command, see\n`addTraceAsMessages`.\n","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.messages","kind":"def","line":74,"name":"Lean.PostprocessTraces.StoredTrace.messages","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L74-L74"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">StoredTrace</span>.<span class=\"name\">mk</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/Message.html#Lean.Message\">Lean.Message</a></span> → <a href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\">Lean.PostprocessTraces.StoredTrace</a></span></div></div>","info":{"doc":"","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace.mk","kind":"ctor","line":60,"name":"Lean.PostprocessTraces.StoredTrace.mk","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L60-L75"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">StoredTrace</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"A trace stored by `store_traces_as t in cmd`, for inspection in metaprograms.\n\n`store_traces_as` declares `t : CoreM StoredTrace`, so the stored trace can be retrieved in any\nmetaprogram that can run `CoreM`, e.g. `#eval do return (← t).roots.size`. The trace data itself\nis kept in an in-memory environment extension and is only available in the file that stored it;\nin particular, it is not exported to `.olean` files. The declaration only holds a reference, so\ndeclaring it is cheap even for very large traces.\n","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.StoredTrace","kind":"structure","line":60,"name":"Lean.PostprocessTraces.StoredTrace","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L60-L75"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.postprocessStoredTracesCmd\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">postprocessStoredTracesCmd</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Experimental. `#postprocess_traces` and the library around it are expected to change in the\nfuture.\n\n`#postprocess_traces t post` applies the trace postprocessor `post : TracePostprocessor` to the\ntrace stored as `t` by `store_traces_as t in cmd` and then renders the resulting trace tree.\nSee `postprocess_traces` for the available operations and patterns.\n","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.postprocessStoredTracesCmd","kind":"def","line":49,"name":"Lean.PostprocessTraces.postprocessStoredTracesCmd","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L49-L58"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.storeTracesAsCmd\"><span class=\"name\">Lean</span>.<span class=\"name\">PostprocessTraces</span>.<span class=\"name\">storeTracesAsCmd</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Experimental. `store_traces_as` and the library around it are expected to change in the future.\n\n`store_traces_as t in cmd` runs `cmd`, reports its output unchanged, and additionally stores the\ntrace messages it produced under the name `t`. The stored trace can then be inspected\nwithout re-running `cmd` using `#trace_roots t` and `#postprocess_traces t post`, which is useful\nwhen `cmd` is slow and the right trace postprocessor is found iteratively.\n\n`store_traces_as` also adds a declaration `t : CoreM Lean.PostprocessTraces.StoredTrace` to the\nenvironment, so the trace can be inspected by arbitrary metaprograms, e.g.\n`#eval do return (← t).roots.size`. The declaration only references the trace data, which is\nkept in memory for the current file only; it is not exported to `.olean` files.\n","docLink":"./Lean/PostprocessTraces/StoredTraces.html#Lean.PostprocessTraces.storeTracesAsCmd","kind":"def","line":33,"name":"Lean.PostprocessTraces.storeTracesAsCmd","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Lean/PostprocessTraces/StoredTraces.lean#L33-L47"}}],"imports":["Lean.CoreM","Lean.Elab.Command","Lean.PostprocessTraces.Basic"],"instances":[{"className":"Inhabited","name":"Lean.PostprocessTraces.instInhabitedStoredTrace","typeNames":["Lean.PostprocessTraces.StoredTrace"]}],"name":"Lean.PostprocessTraces.StoredTraces"}