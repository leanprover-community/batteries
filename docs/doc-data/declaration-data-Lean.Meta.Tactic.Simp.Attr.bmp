mp/Attr.html#Lean.Meta.simpExtension","kind":"opaque","line":94,"name":"Lean.Meta.simpExtension","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Simp/Attr.lean#L94-L94"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Simp/Attr.html#Lean.Meta.registerSimpAttr\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">registerSimpAttr</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">attrName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">attrDescr</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ref</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a> := by exact decl_name%)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/System/IO.html#IO\">IO</a> <a href=\"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.SimpExtension\">SimpExtension</a></span></div></div>","info":{"doc":"Registers the given name as a custom simp set. Applying the name as an attribute to a name adds it\nto the simp set, and using the name as a parameter to the `simp` tactic causes `simp` to use the\nincluded lemmas.\n\nCustom simp sets must be registered during [initialization](https://lean-lang.org/doc/reference/4.37.0-rc1/find/?domain=Verso.Genre.Manual.section&name=initialization).\n\nThe description should be a short, singular noun phrase that describes the contents of the custom\nsimp set.","docLink":"./Lean/Meta/Tactic/Simp/Attr.html#Lean.Meta.registerSimpAttr","kind":"def","line":77,"name":"Lean.Meta.registerSimpAttr","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Simp/Attr.lean#L77-L92"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Simp/Attr.html#Lean.Meta.mkSimpAttr\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkSimpAttr</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">attrName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">attrDescr</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ext</span> : <a href=\"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.SimpExtension\">SimpExtension</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ref</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a> := by exact decl_name%)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/System/IO.html#IO\">IO</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Tactic/Simp/Attr.html#Lean.Meta.mkSimpAttr","kind":"def","line":36,"name":"Lean.Meta.mkSimpAttr","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Simp/Attr.lean#L36-L75"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Simp/Attr.html#Lean.Meta.addDeclToUnfold\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">addDeclToUnfold</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ext</span> : <a href=\"./Lean/Meta/Tactic/Simp/SimpTheorems.html#Lean.Meta.SimpExtension\">SimpExtension</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">declName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">post </span><span class=\"fn\">inv</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">prio</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">attrKind</span> : <a href=\"./Lean/Attributes.html#Lean.AttributeKind\">AttributeKind</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Marks `declName` to be unfolded in the given `SimpExtension`.","docLink":"./Lean/Meta/Tactic/Simp/Attr.html#Lean.Meta.addDeclToUnfold","kind":"def","line":13,"name":"Lean.Meta.addDeclToUnfold","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Simp/Attr.lean#L13-L34"}}],"imports":["Lean.Meta.Tactic.Simp.Simproc"],"instances":[],"name":"Lean.Meta.Tactic.Simp.Attr"}