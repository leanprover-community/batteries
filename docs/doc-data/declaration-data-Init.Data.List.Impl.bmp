span class=\"fn\">α</span></span></div></div>","info":{"doc":"Computes the sum of the elements of a list.\n\nThis is the implementation of `List.sum` used at runtime; it is compiled using `List.foldrTR`.","docLink":"./Init/Data/List/Impl.html#List.sumTR","kind":"def","line":154,"name":"List.sumTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L154-L160"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.foldr_eq_foldrTR\"><span class=\"name\">List</span>.<span class=\"name\">foldr_eq_foldrTR</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\">@<a href=\"./Init/Data/List/Basic.html#List.foldr\">foldr</a> <a href=\"./Init/Prelude.html#Eq\">=</a> @<a href=\"./Init/Data/List/Impl.html#List.foldrTR\">foldrTR</a></div></div>","info":{"doc":"","docLink":"./Init/Data/List/Impl.html#List.foldr_eq_foldrTR","kind":"theorem","line":149,"name":"List.foldr_eq_foldrTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L149-L150"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.foldrTR\"><span class=\"name\">List</span>.<span class=\"name\">foldrTR</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a> u_2}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\"><span class=\"fn\">β</span> → <span class=\"fn\">β</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">init</span> : <span class=\"fn\">β</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">β</span></div></div>","info":{"doc":"Folds a function over a list from the right, accumulating a value starting with `init`. The\naccumulated value is combined with the each element of the list in reverse order, using `f`.\n\n`O(|l|)`. This is the tail-recursive replacement for `List.foldr` in runtime code.\n\nExamples:\n * `[a, b, c].foldrTR f init  = f a (f b (f c init))`\n * `[1, 2, 3].foldrTR (toString · ++ ·) \"\" = \"123\"`\n * `[1, 2, 3].foldrTR (s!\"({·} {·})\") \"!\" = \"(1 (2 (3 !)))\"`","docLink":"./Init/Data/List/Impl.html#List.foldrTR","kind":"def","line":136,"name":"List.foldrTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L136-L147"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.reduceOption\"><span class=\"name\">List</span>.<span class=\"name\">reduceOption</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">α</span>)</span></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">α</span></span></span></div></div>","info":{"doc":"Drop `none`s from a list, and replace each remaining `some a` with `a`.","docLink":"./Init/Data/List/Impl.html#List.reduceOption","kind":"def","line":130,"name":"List.reduceOption","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L130-L132"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.filterMap_eq_filterMapTR\"><span class=\"name\">List</span>.<span class=\"name\">filterMap_eq_filterMapTR</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\">@<a href=\"./Init/Data/List/Basic.html#List.filterMap\">filterMap</a> <a href=\"./Init/Prelude.html#Eq\">=</a> @<a href=\"./Init/Data/List/Impl.html#List.filterMapTR\">filterMapTR</a></div></div>","info":{"doc":"","docLink":"./Init/Data/List/Impl.html#List.filterMap_eq_filterMapTR","kind":"theorem","line":118,"name":"List.filterMap_eq_filterMapTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L118-L126"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.filterMapTR.go\"><span class=\"name\">List</span>.<span class=\"name\">filterMapTR</span>.<span class=\"name\">go</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a> u_2}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">β</span></span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">α</span></span> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">β</span></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">β</span></span></span></span></div></div>","info":{"doc":"Auxiliary for `filterMap`: `filterMap.go f l = acc.toList ++ filterMap f l`","docLink":"./Init/Data/List/Impl.html#List.filterMapTR.go","kind":"def","line":112,"name":"List.filterMapTR.go","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L112-L116"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.filterMapTR\"><span class=\"name\">List</span>.<span class=\"name\">filterMapTR</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a> u_2}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\"><span class=\"fn\">α</span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">β</span></span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">β</span></span></div></div>","info":{"doc":"Applies a function that returns an `Option` to each element of a list, collecting the non-`none`\nvalues.\n\n`O(|l|)`. This is a tail-recursive version of `List.filterMap`, used at runtime.\n\nExample:\n```lean example\n#eval [1, 2, 5, 2, 7, 7].filterMapTR fun x =>\n  if x > 2 then some (2 * x) else none\n```\n```output\n[10, 14, 14]\n```","docLink":"./Init/Data/List/Impl.html#List.filterMapTR","kind":"def","line":95,"name":"List.filterMapTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L95-L116"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.set_eq_setTR\"><span class=\"name\">List</span>.<span class=\"name\">set_eq_setTR</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\">@<a href=\"./Init/Prelude.html#List.set\">set</a> <a href=\"./Init/Prelude.html#Eq\">=</a> @<a href=\"./Init/Data/List/Impl.html#List.setTR\">setTR</a></div></div>","info":{"doc":"","docLink":"./Init/Data/List/Impl.html#List.set_eq_setTR","kind":"theorem","line":83,"name":"List.set_eq_setTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L83-L90"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/Data/List/Impl.html#List.setTR\"><span class=\"name\">List</span>.<span class=\"name\">setTR</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a> u_1}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"Replaces the value at (zero-based) index `n` in `l` with `a`. If the index is out of bounds, then\nthe list is returned unmodified.\n\nThis is a tail-recursive version of `List.set` that's used at runtime.\n\nExamples:\n* `[\"water\", \"coffee\", \"soda\", \"juice\"].set 1 \"tea\" = [\"water\", \"tea\", \"soda\", \"juice\"]`\n* `[\"water\", \"coffee\", \"soda\", \"juice\"].set 4 \"tea\" = [\"water\", \"coffee\", \"soda\", \"juice\"]`","docLink":"./Init/Data/List/Impl.html#List.setTR","kind":"def","line":65,"name":"List.setTR","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Init/Data/List/Impl.lean#L65-L81"}}],"imports":["Init.Data.Array.Bootstrap","Init.Data.Bool","Init.Data.List.Basic","Init.Data.List.Lemmas","Init.Data.Option.Lemmas","Init.Ext"],"instances":[],"name":"Init.Data.List.Impl"}