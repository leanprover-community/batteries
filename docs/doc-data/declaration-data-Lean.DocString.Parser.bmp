nprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1056-L1056"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.InlineCtxt.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">InlineCtxt</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Bool\">Bool</a> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Bool\">Bool</a> → <span class=\"fn\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Lean.Parser.ParserFn</a> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.InlineCtxt\">Lean.Doc.Parser.InlineCtxt</a></span></span></span></span></span></div></div>","info":{"doc":"","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.InlineCtxt.mk","kind":"ctor","line":1051,"name":"Lean.Doc.Parser.InlineCtxt.mk","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1051-L1076"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.InlineCtxt\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">InlineCtxt</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"The context within which a newline element is parsed.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.InlineCtxt","kind":"structure","line":1051,"name":"Lean.Doc.Parser.InlineCtxt","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1051-L1076"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.nameAndArgsFn\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">nameAndArgsFn</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">tail</span> : <a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a> := <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.argEndWs\">argEndWs</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">closes</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Char\">Char</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span> := <span class=\"fn\">fun (<span class=\"fn\">x</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>) =&gt; <a href=\"./Init/Prelude.html#Bool.false\">false</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Parses a name and zero or more arguments to a role, directive, command, or code block. The final\ntoken of the name and of each argument records the input that `tail` consumes as its trailing\nwhitespace. The name and arguments must be on the line the parser starts on. A starting position\nat the beginning of a line fails to parse a name.\n\nThe caller's own tokens record the whitespace before the name. If a caller lets this parser consume\nthat whitespace instead, no token records it.\n\nError recovery stops at characters that satisfy `closes`, which should delimit the current argument\nlist (e.g. via a role's `}`).","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.nameAndArgsFn","kind":"def","line":1031,"name":"Lean.Doc.Parser.nameAndArgsFn","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1031-L1049"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.argsFn\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">argsFn</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">tail</span> : <a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a> := <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.argEndWs\">argEndWs</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">closes</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Char\">Char</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span> := <span class=\"fn\">fun (<span class=\"fn\">x</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>) =&gt; <a href=\"./Init/Prelude.html#Bool.false\">false</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Parses zero or more arguments to a role, directive, command, or code block. Each argument's final\ntoken records the input `tail` consumes as its trailing whitespace. The argument list must be on\nthe line the parser starts on. A starting position at the beginning of a line means the list has\nalready ended, so the list is empty.\n\nError recovery stops at characters that satisfy `closes`, which should delimit the current argument\nlist (e.g. via a role's `}`).","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.argsFn","kind":"def","line":1010,"name":"Lean.Doc.Parser.argsFn","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1010-L1022"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.argFn\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">argFn</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">tail</span> : <a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a> := <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.skipFn\">skipFn</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">closes</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Char\">Char</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span> := <span class=\"fn\">fun (<span class=\"fn\">x</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>) =&gt; <a href=\"./Init/Prelude.html#Bool.false\">false</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Parses an argument to a role, directive, command, or code block, which may be named or positional or\na flag. The argument's final token records the input `tail` consumes as its trailing whitespace.\n\nError recovery stops at characters that satisfy `closes`, which should delimit the current argument\nlist (e.g. via a role's `}`).","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.argFn","kind":"def","line":941,"name":"Lean.Doc.Parser.argFn","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L941-L992"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.argEndWs\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">argEndWs</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"The whitespace after an argument, recorded on the argument's last token as its trailing whitespace:\nthe spaces that follow it.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.argEndWs","kind":"def","line":935,"name":"Lean.Doc.Parser.argEndWs","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L935-L939"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.recoverBlockAtErrPos\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">recoverBlockAtErrPos</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">p</span> : <a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Runs `p`, and on failure consumes input with `recover` until parsing may continue. The error is\nrecorded where `p` stopped, so that it marks the input that could not be read rather than the input\nthat recovery passed over.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.recoverBlockAtErrPos","kind":"def","line":863,"name":"Lean.Doc.Parser.recoverBlockAtErrPos","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L863-L864"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.valFn\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">valFn</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">trailing</span> : <a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a> := <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.skipFn\">skipFn</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Parses an argument value, which may be a string, an identifier, or a numeral. The value's token\nrecords the input consumed by `trailing` as its trailing whitespace.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.valFn","kind":"def","line":781,"name":"Lean.Doc.Parser.valFn","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L781-L814"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.blockOpenerFn\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">blockOpenerFn</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Parses block opener prefixes. If this parser succeeds at the beginning of a line, then a special\nblock is beginning.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.