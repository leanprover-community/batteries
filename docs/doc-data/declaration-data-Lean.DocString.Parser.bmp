String/Parser.html#Lean.Doc.Parser.BlockCtxt.mk\">}</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Parser/Types.html#Lean.Parser.ParserFn\">Parser.ParserFn</a></div></div>","info":{"doc":"Parses a metadata block, which contains the contents of a Lean structure initialization but is\nsurrounded by `%%%` on each side.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.metadataBlockFn","kind":"def","line":1552,"name":"Lean.Doc.Parser.metadataBlockFn","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1552-L1584"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.forDocString\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">forDocString</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">text</span> : <a href=\"./Lean/Data/Position.html#Lean.FileMap\">FileMap</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">openPos </span><span class=\"fn\">startPos </span><span class=\"fn\">endPos</span> : <a href=\"./Init/Prelude.html#String.Pos.Raw\">String.Pos.Raw</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a></div></div>","info":{"doc":"Computes the `BlockCtxt` for parsing a docstring whose opening delimiter is at `openPos` and whose\ncontent begins at `startPos`, on the line where that content starts and separated from it by spaces\nalone. `endPos` is the position of the `-` before the `/` in the closing delimiter.\n\nWhen the docstring content starts mid-line (e.g. `/-! # Header -/`), the `docStartPosition` is set\nto the position after any leading spaces so that headers on the first line are recognized. For\nindented docstrings, `baseColumn` is computed as the minimum column among the opening delimiter, the\nclosing delimiter, and the least-indented non-empty content line.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.forDocString","kind":"def","line":1476,"name":"Lean.Doc.Parser.BlockCtxt.forDocString","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1476-L1510"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.instReprBlockCtxt.repr\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">instReprBlockCtxt</span>.<span class=\"name\">repr</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a> → <span class=\"fn\"><a href=\"./Init/Prelude.html#Nat\">Nat</a> → <a href=\"./Init/Data/Format/Basic.html#Std.Format\">Format</a></span></span></div></div>","info":{"doc":"","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.instReprBlockCtxt.repr","kind":"def","line":1434,"name":"Lean.Doc.Parser.instReprBlockCtxt.repr","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1434-L1434"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.instReprBlockCtxt\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">instReprBlockCtxt</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Repr.html#Repr\">Repr</a> <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a></span></div></div>","info":{"doc":"","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.instReprBlockCtxt","kind":"instance","line":1434,"name":"Lean.Doc.Parser.instReprBlockCtxt","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1434-L1434"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.instInhabitedBlockCtxt\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">instInhabitedBlockCtxt</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a></span></div></div>","info":{"doc":"","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.instInhabitedBlockCtxt","kind":"instance","line":1434,"name":"Lean.Doc.Parser.instInhabitedBlockCtxt","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1434-L1434"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.baseColumn\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">baseColumn</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"The base column of the docstring, which is the least indentation of any non-empty line in it,\nincluding the opening and closing delimiters. Items that may not nest in blocks, such as headers,\nstart at this column, and a code element's lines treat the indentation up to it as whitespace.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.baseColumn","kind":"def","line":1433,"name":"Lean.Doc.Parser.BlockCtxt.baseColumn","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1433-L1433"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.docStartPosition\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">docStartPosition</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Data/Position.html#Lean.Position\">Position</a></div></div>","info":{"doc":"The position at which the document content starts, used to allow headers on the first line of a\ndocstring (e.g. `/-! # Header -/`). With the default value `⟨1, 0⟩`, the beginning-of-line check\nis unaffected for normal documents.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.docStartPosition","kind":"def","line":1427,"name":"Lean.Doc.Parser.BlockCtxt.docStartPosition","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1427-L1427"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.maxDirective\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">maxDirective</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span></div></div>","info":{"doc":"The block's maximal directive size (that is, the greatest number of allowed colons).","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.maxDirective","kind":"def","line":1421,"name":"Lean.Doc.Parser.BlockCtxt.maxDirective","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1421-L1421"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.recordTrailing\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">recordTrailing</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Whether each block's final token records the whitespace that follows the block as its trailing\nwhitespace.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.recordTrailing","kind":"def","line":1417,"name":"Lean.Doc.Parser.BlockCtxt.recordTrailing","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1417-L1417"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.topLevel\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">topLevel</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt\">BlockCtxt</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Whether blocks in this context are at the document's top level, rather than the contents of\nanother block.","docLink":"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.topLevel","kind":"def","line":1412,"name":"Lean.Doc.Parser.BlockCtxt.topLevel","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/DocString/Parser.lean#L1412-L1412"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/DocString/Parser.html#Lean.Doc.Parser.BlockCtxt.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">Parser</span>.<span class=\"name\">BlockCtxt</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Bool\">Bool</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</