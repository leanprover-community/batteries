Data/URI/Encoding.html#Std.Http.URI.hexDigitToUInt8?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">hexDigitToUInt8?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#UInt8\">UInt8</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#UInt8\">UInt8</a></span></div></div>","info":{"doc":"Converts a hexadecimal digit character to its numeric value (0-15).\nReturns `none` if the character is not a valid hex digit.","docLink":"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.hexDigitToUInt8?","kind":"def","line":111,"name":"Std.Http.URI.hexDigitToUInt8?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Encoding.lean#L111-L123"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.hexDigit\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">hexDigit</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#UInt8\">UInt8</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt8\">UInt8</a></div></div>","info":{"doc":"Converts a nibble (4-bit value, 0-15) to its hexadecimal digit representation. Returns '0'-'9' for\nvalues 0-9, and 'A'-'F' for values 10-15.","docLink":"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.hexDigit","kind":"def","line":103,"name":"Std.Http.URI.hexDigit","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Encoding.lean#L103-L109"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.isValidPercentEncoding\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">isValidPercentEncoding</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ba</span> : <a href=\"./Init/Prelude.html#ByteArray\">ByteArray</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Validates that all percent signs in a byte array are followed by exactly two hexadecimal digits.\nThis ensures proper percent-encoding according to RFC 3986.\n\nFor example:\n- `%20` is valid (percent followed by two hex digits)\n- `%` is invalid (percent with no following digits)\n- `%2` is invalid (percent followed by only one digit)\n- `%GG` is invalid (percent followed by non-hex characters)","docLink":"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.isValidPercentEncoding","kind":"def","line":76,"name":"Std.Http.URI.isValidPercentEncoding","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Data/URI/Encoding.lean#L76-L101"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.instDecidableIsAllowedEncodedQueryChars\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">instDecidableIsAllowedEncodedQueryChars</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">r</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#UInt8\">UInt8</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span>}</span></span> </span><span class=\"im