yteArray\">ByteArray</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Decidable\">Decidable</a> <span class=\"fn\">(<a href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.IsAllowedEncodedChars\">IsAllowedEncodedChars</a> <span class=\"fn\">r</span> <span class=\"fn\">s</span>)</span></span></div></div>","info":{"doc":"","docLink":"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.instDecidableIsAllowedEncodedChars","kind":"instance","line":58,"name":"Std.Http.URI.instDecidableIsAllowedEncodedChars","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Std/Http/Data/URI/Encoding.lean#L58-L59"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.IsAllowedEncodedChars\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">URI</span>.<span class=\"name\">IsAllowedEncodedChars</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">rule</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#UInt8\">UInt8</a> → <a href=\"./Init/Prelude.html#Bool\">Bool</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#ByteArray\">ByteArray</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Prop</a></div></div>","info":{"doc":"Checks if all characters in a `ByteArray` are allowed in an encoded URI component. This is a fast check\nthat only verifies the character set, not full encoding validity.","docLink":"./Std/Http/Data/URI/Encoding.html#Std.Http.URI.IsAllowedEncodedChars","kind":"def","line":50,"name":"Std.Http.URI.IsAllowedEncodedChars","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc0