d601f225c321/src/Std/Http/Internal/String.lean#L126-L130"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">noncomputable def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Internal/String.html#Std.Http.Internal.isToken\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Internal</span>.<span class=\"name\">isToken</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Checks whether a string is a valid non-empty HTTP token.","docLink":"./Std/Http/Internal/String.html#Std.Http.Internal.isToken","kind":"def","line":118,"name":"Std.Http.Internal.isToken","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Internal/String.lean#L118-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Internal/String.html#Std.Http.Internal.unquoteHttpString?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Internal</span>.<span class=\"name\">unquoteHttpString?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Parses an HTTP `quoted-string`, returning the unescaped content when valid.","docLink":"./Std/Http/Internal/String.html#Std.Http.Internal.unquoteHttpString?","kind":"def","line":93,"name":"Std.Http.Internal.unquoteHttpString?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Internal/String.lean#L93-L116"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Internal/String.html#Std.Http.Internal.quoteHttpString!\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Internal</span>.<span class=\"name\">quoteHttpString!</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#String\">String</a></div></div>","info":{"doc":"Quotes `s` as an HTTP `quoted-string`, panicking if `s` contains characters that cannot be\nrepresented by `qdtext`/`quoted-pair`.","docLink":"./Std/Http/Internal/String.html#Std.Http.Internal.quoteHttpString!","kind":"def","line":78,"name":"Std.Http.Internal.quoteHttpString!","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Internal/String.lean#L78-L85"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Internal/String.html#Std.Http.Internal.quoteHttpString?\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Internal</span>.<span class=\"name\">quoteHttpString?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Attempts to quote `s` as an HTTP `quoted-string`.\n\nReturns `some` with the quoted result when every character passes `quotedStringChar`, or `none`\nwhen any character cannot be represented by the grammar.","docLink":"./Std/Http/Internal/String.html#Std.Http.Internal.quoteHttpString?","kind":"def","line":66,"name":"Std.Http.Internal.quoteHttpString?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Internal/String.lean#L66-L76"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Internal/String.html#Std.Http.Internal.quoteHttpString\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Internal</span>.<span class=\"name\">quoteHttpString</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Prelude.html#String\">String</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">s</span>.<a href=\"./Init/Data/String/Basic.html#String.toList\">toList</a></span>.<a href=\"./Init/Data/List/Basic.html#List.all\">all</a></span> <a href=\"./Std/Http/Internal/Char.html#Std.Http.Internal.Char.quotedStringChar\">Char.quotedStringChar</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <a href=\"./Init/Prelude.html#Bool.true\">true</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#String\">String</a></div></div>","info":{"doc":"Quotes `s` as an HTTP `quoted-string`: `DQUOTE *( qdtext / quoted-pair ) DQUOTE`.\n\nIf every character is a `tchar` and the string is non-empty, the string is returned as-is (it is\nalready a valid token). Otherwise the string is wrapped in double quotes, escaping `\"` and `\\`\nas `quoted-pair`.\n\nRequires a proof that every character passes `quotedStringChar`.","docLink":"./Std/Http/Internal/String.html#Std.Http.Internal.quoteHttpString","kind":"def","line":45,"name":"Std.Http.Internal.quoteHttpString","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Internal/String.lean#L45-L64"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Std/Http/Internal/String.html#Std.Http.Internal.quoteCore\"><span class=\"name\">Std</span>.<span class=\"name\">Http</span>.<span class=\"name\">Internal</span>.<span class=\"name\">quoteCore</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h₀</span> : <span class=\"fn\"><a href=\"./Std/Http/Internal/Char.html#Std.Http.Internal.Char.quotedStringChar\">Char.quotedStringChar</a> <span class=\"fn\">c</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <a href=\"./Init/Prelude.html#Bool.true\">true</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#String\">String</a></div></div>","info":{"doc":"Core character quoting used by `quoteHttpString`.\n\nEmits `qdtext` characters directly and `\"` / `\\\\` as `quoted-pair`.\nThe proof `h₀ : quotedStringChar c` guarantees the impossible branch is unreachable.","docLink":"./Std/Http/Internal/String.html#Std.Http.Internal.quoteCore","kind":"def","line":31,"name":"Std.Http.Internal.quoteCore","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Std/Http/Internal/String.lean#L31-L43"}}],"imports":["Init.Data.String.Csimp","Init.Data.String.Lemmas.Pattern.TakeDrop.Pred","Init.Data.String.TakeDrop","Init.Grind","Std.Http.Internal.Char"],"instances":[],"name":"Std.Http.Internal.String"}