an class=\"fn\">(<span class=\"fn\">mutVars</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.MutVar\">MutVar</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">k</span> : <span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">info</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a> := <a href=\"./Init/Prelude.html#Bool.true\">true</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Bind the `.out` projection of each erased variable among `mutVars` around `k`. ","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.withErasedProjs","kind":"def","line":626,"name":"Lean.Elab.Do.withErasedProjs","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L626-L628"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.withErasedProj\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">withErasedProj</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">x</span> : <a href=\"./Init/Meta/Defs.html#Lean.Syntax.Ident\">Ident</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">k</span> : <span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">info</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a> := <a href=\"./Init/Prelude.html#Bool.true\">true</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Bind `x` to `carried.out` at the underlying type while `k` runs, and zeta-substitute the\nbinding away, so the source name reaches proofs and never compiled code. The newest binding of\n`x` must be the carried `Erased` binding. ","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.withErasedProj","kind":"def","line":608,"name":"Lean.Elab.Do.withErasedProj","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L608-L624"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.registerMutVarAlias\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">registerMutVarAlias</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">x</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"If `x` is a `mut` variable, record that its current binding aliases the original `let mut` binding,\nso that go-to-definition and find-references treat both as the same variable.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.registerMutVarAlias","kind":"def","line":598,"name":"Lean.Elab.Do.registerMutVarAlias","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L598-L606"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.withDeadCodeFromInfo\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">withDeadCodeFromInfo</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">info</span> : <a href=\"./Lean/Elab/Do/InferControlInfo.html#Lean.Elab.Do.ControlInfo\">ControlInfo</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a></div></div>","info":{"doc":"Wrap `dec.k` so it elaborates as dead iff `info.noFallthrough`. ","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.withDeadCodeFromInfo","kind":"def","line":594,"name":"Lean.Elab.Do.DoElemCont.withDeadCodeFromInfo","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L594-L596"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.elabAsSyntacticallyDeadCode\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">elabAsSyntacticallyDeadCode</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Elaborate the `DoElemCont` with the `deadCode` flag set to `deadSyntactically` to emit warnings. ","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.elabAsSyntacticallyDeadCode","kind":"def","line":582,"name":"Lean.Elab.Do.DoElemCont.elabAsSyntacticallyDeadCode","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L582-L592"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.continueWithUnit\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">continueWithUnit</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Return `let $k.resultName : PUnit := PUnit.unit; $(← k.k)`, ensuring that the result type of `k.k`\nis `PUnit` and then immediately zeta-reduce the `let`.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.continueWithUnit","kind":"def","line":573,"name":"Lean.Elab.Do.DoElemCont.continueWithUnit","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L573-L580"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.mkBindUnlessPure\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">mkBindUnlessPure</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Return `$e >>= fun ($dec.resultName : $dec.resultType) => $(← dec.k)`, cancelling\nthe bind if `$(← dec.k)` is `pure $dec.resultName` or `e` is some `pure` computation.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.mkBindUnlessPure","kind":"def","line":527,"name":"Lean.Elab.Do.DoElemCont.mkBindUnlessPure","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L527-L571"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.ensureUnit\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">ensureUnit</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a></span></div></div>","info":{"doc":"Given a continuation `dec`, returns a continuation derived from `dec` with result type `PUnit`.\nIf `dec` already has result type `PUnit`, simply returns `dec`. Otherwise, an error is logged and a\nnew continuation is returned that calls `dec` with `sorry` as a result.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.ensureUnit","kind":"def","line":519,"name":"Lean.Elab.Do.DoElemCont.ensureUnit","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L519-L525"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.ensureUnitAt\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">ensureUnitAt</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">ref</span> : <a href=\"./Init/Prelude.html#Lean.Syntax\">Syntax</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a></span></div></div>","info":{"doc":"Given a continuation `dec` and a reference `ref`, returns a continuation derived from `dec` with result type `PUnit`.\nIf `dec` already has result type `PUnit`, simply returns `dec`. Otherwise, an error is logged and a\nnew continuation is returned that calls `dec` with `sorry` as a result. The error is reported at `ref`.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.ensureUnitAt","kind":"def","line":511,"name":"Lean.Elab.Do.DoElemCont.ensureUnitAt","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L511-L517"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.ensureHasTypeAt\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoElemCont</span>.<span class=\"name\">ensureHasTypeAt</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">dec</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">ref</span> : <a href=\"./Init/Prelude.html#Lean.Syntax\">Syntax</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">elementType</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont\">DoElemCont</a></span></div></div>","info":{"doc":"Given a continuation `dec`, a reference `ref`, and an element result type `elementType`, returns a\ncontinuation derived from `dec` with result type `elementType`.\nIf `dec` already has result type `elementType`, simply returns `dec`.\nOtherwise, an error is logged and a new continuation is returned that calls `dec` with `sorry` as a\nresult. The error is reported at `ref`.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElemCont.ensureHasTypeAt","kind":"def","line":488,"name":"Lean.Elab.Do.DoElemCont.ensureHasTypeAt","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L488-L509"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.mkMonadicResultTypeMismatchError\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">mkMonadicResultTypeMismatchError</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">contType </span><span class=\"fn\">elementType</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Message.html#Lean.MessageData\">MessageData</a></div></div>","info":{"doc":"","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.mkMonadicResultTypeMismatchError","kind":"def","line":484,"name":"Lean.Elab.Do.mkMonadicResultTypeMismatchError","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L484-L486"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.withLCtxKeepingMutVarDefs\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">withLCtxKeepingMutVarDefs</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">oldLCtx</span> : <a href=\"./Lean/LocalContext.html#Lean.LocalContext\">LocalContext</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">oldCtx</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.Context\">Context</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">resultName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">k</span> : <span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <span class=\"fn\">α</span></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"Restores the local context to `oldCtx` and adds the new reaching definitions of the mut vars and\nresult. Then resume the continuation `k` with the `mutVars` restored to the given `oldMutVars`.\n\nThis function is useful to de-nest\n```\nlet mut x := 0\nlet y := 3\nlet z ← do\n  let mut y ← e\n  x := y + 1\n  pure y\nlet y := y + 3\npure (x + y + z)\n```\ninto\n```\nlet mut x := 0\nlet y := 3\nlet mut y† ← e\nx := y† + 1\nlet z ← pure y†\nlet y := y + 3\npure (x + y + z)\n```\nNote that the continuation of the `let z ← ...` bind, roughly\n``k := .cont `z _ `(let y := y + 3; pure (x + y + z))``,\nneeds to be elaborated in a local context that contains the reassignment of `x`, but not the shadowing\nmut var definition of `y`.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.withLCtxKeepingMutVarDefs","kind":"def","line":444,"name":"Lean.Elab.Do.withLCtxKeepingMutVarDefs","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L444-L482"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.getReassignedMutVars\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">getReassignedMutVars</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">rootCtx</span> : <a href=\"./Lean/LocalContext.html#Lean.LocalContext\">LocalContext</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">mutVars</span> : <span class=\"fn\"><a href=\"./Std/Data/HashSet/Basic.html#Std.HashSet\">Std.HashSet</a> <a href=\"./Init/Prelude.html#Lean.Name\">Name</a></span>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">childCtxs</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/LocalContext.html#Lean.LocalContext\">LocalContext</a></span>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Std/Data/HashSet/Basic.html#Std.HashSet\">Std.HashSet</a> <a href=\"./Init/Prelude.html#Lean.Name\">Name</a></span></div></div>","info":{"doc":"The subset of `mutVars` that were reassigned in any of the `childCtxs` relative to the given\n`rootCtx`.\n","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.getReassignedMutVars","kind":"def","line":414,"name":"Lean.Elab.Do.getReassignedMutVars","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L414-L423"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.withDeadCode\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">withDeadCode</span></a></span><span class=\"impl_arg\"><span class=\"decl_args\">\n<span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span>\n</span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">deadCode</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.CodeLiveness\">CodeLiveness</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">k</span> : <span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM<