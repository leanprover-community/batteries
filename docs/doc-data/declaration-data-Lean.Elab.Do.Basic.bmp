ab/Do/Basic.html#Lean.Elab.Do.DoOps.toDoOpsRefImpl\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoOps</span>.<span class=\"name\">toDoOpsRefImpl</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">o</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps\">DoOps</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOpsRef\">DoOpsRef</a></div></div>","info":{"doc":"","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps.toDoOpsRefImpl","kind":"def","line":169,"name":"Lean.Elab.Do.DoOps.toDoOpsRefImpl","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L169-L170"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.instInhabitedDoOps\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">instInhabitedDoOps</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps\">DoOps</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.instInhabitedDoOps","kind":"instance","line":167,"name":"Lean.Elab.Do.instInhabitedDoOps","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L167-L167"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps.mkMonadApp\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoOps</span>.<span class=\"name\">mkMonadApp</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps\">DoOps</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a> → <span class=\"fn\"><a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoElabM\">DoElabM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></span></div></div>","info":{"doc":"Construct `m α` from `α`. ","docLink":"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps.mkMonadApp","kind":"def","line":166,"name":"Lean.Elab.Do.DoOps.mkMonadApp","sourceLink":"https://github.com/leanprover/lean4/blob/470d5ce1400764999581fd26d5d72b00d990b0f4/src/Lean/Elab/Do/Basic.lean#L166-L166"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps.splitMonadApp?\"><span class=\"name\">Lean</span>.<span class=\"name\">Elab</span>.<span class=\"name\">Do</span>.<span class=\"name\">DoOps</span>.<span class=\"name\">splitMonadApp?</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">self</span> : <a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.DoOps\">DoOps</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a> → <span class=\"fn\"><a href=\"./Lean/Elab/Term/TermElabM.html#Lean.Elab.Term.TermElabM\">TermElabM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> (<a href=\"./Lean/Elab/Do/Basic.html#Lean.Elab.Do.MonadInfo\">MonadInfo</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>))</span></span></span></div></div>","info":{"doc":"Match a monad application `m α`, returning `MonadInfo` for `m` and `α`. ","docLin