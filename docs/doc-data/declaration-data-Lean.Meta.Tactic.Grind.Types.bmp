":"def","line":2124,"name":"Lean.Meta.Grind.Goal.mkAuxMVar","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L2124-L2133"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.Goal.withContext\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">Goal</span>.<span class=\"name\">withContext</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m</span> : <span class=\"fn\"><a href=\"./foundational_types.html\">Type</a> → <a href=\"./foundational_types.html\">Type</a> u_1</span>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Control/Basic.html#MonadControlT\">MonadControlT</a> <a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <span class=\"fn\">m</span></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Prelude.html#Monad\">Monad</a> <span class=\"fn\">m</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">goal</span> : <a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.Goal\">Goal</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">m</span> <span class=\"fn\">α</span></span> → <span class=\"fn\"><span class=\"fn\">m</span> <span class=\"fn\">α</span></span></span></div></div>","info":{"doc":"`goal.withContext x` executes `x` using the given metavariable `LocalContext` and `LocalInstances`.\nThe type class resolution cache is flushed when executing `x` if its `LocalInstances` are\ndifferent from the current ones.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.Goal.withContext","kind":"def","line":2117,"name":"Lean.Meta.Grind.Goal.withContext","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L2117-L2122"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.MVarId.assignFalseProof\"><span class=\"name\">Lean</span>.<span class=\"name\">MVarId</span>.<span class=\"name\">assignFalseProof</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">mvarId</span> : <a href=\"./Lean/Expr.html#Lean.MVarId\">MVarId</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">falseProof</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Assign the `mvarId` using the given proof of `False`.\nIf type of `mvarId` is not `False`, then use `False.elim`.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.MVarId.assignFalseProof","kind":"def","line":2103,"name":"Lean.MVarId.assignFalseProof","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L2103-L2115"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.markAsInconsistent\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">markAsInconsistent</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.GoalM\">GoalM</a> <a href=\"./Init/Prelude.html#Unit\">Unit</a></span></div></div>","info":{"doc":"Marks current goal as inconsistent without assigning `mvarId`.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.markAsInconsistent","kind":"def","line":2097,"name":"Lean.Meta.Grind.markAsInconsistent","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L2097-L2101"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.mkEqBoolFalseProof\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">mkEqBoolFalseProof</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.GoalM\">GoalM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Returns a proof that `a = Bool.false`.\nIt assumes `a` and `Bool.false` are in the same equivalence class.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.mkEqBoolFalseProof","kind":"def","line":2090,"name":"Lean.Meta.Grind.mkEqBoolFalseProof","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L2090-L2095"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.mkEqBoolTrueProof\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">mkEqBoolTrueProof</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.GoalM\">GoalM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Returns a proof that `a = Bool.true`.\nIt assumes `a` and `Bool.true` are in the same equivalence class.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.mkEqBoolTrueProof","kind":"def","line":2083,"name":"Lean.Meta.Grind.mkEqBoolTrueProof","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L2083-L2088"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.mkEqFalseProof\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">mkEqFalseProof</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.GoalM\">GoalM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Returns a proof that `a = False`.\nIt assumes `a` and `False` are in the same equivalence class.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.mkEqFalseProof","kind":"def","line":2076,"name":"Lean.Meta.Grind.mkEqFalseProof","sourceLink":"https://github.com/le