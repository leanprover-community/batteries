eader":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.grind.debug.badAnchors\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">grind</span>.<span class=\"name\">debug</span>.<span class=\"name\">badAnchors</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Options.html#Lean.Option\">Lean.Option</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.grind.debug.badAnchors","kind":"opaque","line":182,"name":"Lean.Meta.Grind.grind.debug.badAnchors","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L182-L185"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.grind.debug.proofs\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">grind</span>.<span class=\"name\">debug</span>.<span class=\"name\">proofs</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Options.html#Lean.Option\">Lean.Option</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.grind.debug.proofs","kind":"opaque","line":172,"name":"Lean.Meta.Grind.grind.debug.proofs","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L172-L175"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.backward.grind.normalizer\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">backward</span>.<span class=\"name\">grind</span>.<span class=\"name\">normalizer</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Options.html#Lean.Option\">Lean.Option</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.backward.grind.normalizer","kind":"opaque","line":167,"name":"Lean.Meta.Grind.backward.grind.normalizer","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L167-L170"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">opaque</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.grind.debug\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">grind</span>.<span class=\"name\">debug</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Options.html#Lean.Option\">Lean.Option</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.grind.debug","kind":"opaque","line":162,"name":"Lean.Meta.Grind.grind.debug","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L162-L165"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.isInterpreted\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">isInterpreted</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Init/Prelude.html#Bool\">Bool</a></span></div></div>","info":{"doc":"Returns `true` if `e` is `True`, `False`, or a literal value.\nSee `Lean.Meta.LitValues` for supported literals.\n`grind` assumes distinct interpreted terms denote distinct values, so a literal is interpreted\nonly if it is in normal form, and in particular its type must be structurally a supported\nbuiltin type, with a numeral parameter for `Fin`/`BitVec`.\n`LitValues` recognizes literals up to `whnfD` on their types, e.g.\n`(1 : BitVec w)` for `def w := 32`, but the canonicalizer does not unfold `w`, and\n`(1 : BitVec w)` and `(1 : BitVec 32)` would be distinct interpreted terms denoting the same value.\n\nThe type of a literal is read from `e` itself. For negated literals, both the outer and inner\ntypes must be the same normal type. `Rat`, `Float`, and `Float32` literals are never interpreted.\nA literal of a signed fixed-width type is interpreted only in the form produced by its `ToExpr`\ninstance, i.e., when it is in range: the canonicalizer reduces `OfNat` numerals modulo `2^w`, but\n`(200 : Int8)` and `(-56 : Int8)` still denote the same value, as do `-0` and `0`.\nAssumes `e` has no assigned metavariables.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.isInterpreted","kind":"def","line":112,"name":"Lean.Meta.Grind.isInterpreted","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L112-L160"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.getLitKind\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">getLitKind</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind\">LitKind</a></span></div></div>","info":{"doc":"Classifies the application `e`. For example, `BitVec` and `Fin` are parametric literals, but `Nat` is not.\nThe types of nonparametric literals are reduced using `whnfD`, but `BitVec` and `Fin` must occur syntactically.\nThe type of a negative literal `-n` must also occur syntactically because `internalize` does not visit `n`:\nthe ring normalizer, used for `Int`, `Int8`, `Int16`, `Int32`, and `Int64`, treats `-n` as a constant, but\n`linarith` reifies `-n : α` for `def α := Int` as the negation of the variable `n`.\n`internalize` does not add literal applications to the congruence table.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.getLitKind","kind":"def","line":80,"name":"Lean.Meta.Grind.getLitKind","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L80-L110"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind.ofNatFinBitVec\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">LitKind</span>.<span class=\"name\">ofNatFinBitVec</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind\">LitKind</a></div></div>","info":{"doc":"An `OfNat.ofNat` literal of type `BitVec _` or `Fin _`.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind.ofNatFinBitVec","kind":"ctor","line":77,"name":"Lean.Meta.Grind.LitKind.ofNatFinBitVec","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L77-L78"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind.nonParametric\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">LitKind</span>.<span class=\"name\">nonParametric</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind\">LitKind</a></div></div>","info":{"doc":"A `Nat`, `Int`, `Char`, `UInt8`, `UInt16`, `UInt32`, `UInt64`, `Int8`, `Int16`, `Int32`, or `Int64` literal.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind.nonParametric","kind":"ctor","line":75,"name":"Lean.Meta.Grind.LitKind.nonParametric","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L75-L76"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind.notLit\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">LitKind</span>.<span class=\"name\">notLit</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind\">LitKind</a></div></div>","info":{"doc":"","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind.notLit","kind":"ctor","line":74,"name":"Lean.Meta.Grind.LitKind.notLit","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L74-L74"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">LitKind</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"Literal applications that `internalize` handles specially.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.LitKind","kind":"inductive","line":72,"name":"Lean.Meta.Grind.LitKind","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L72-L78"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.eqCongrSymmPlaceholderProof\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">eqCongrSymmPlaceholderProof</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></div></div>","info":{"doc":"We use this auxiliary constant to mark delayed symmetric congruence proofs.\n**Example:** `a = b` is symmetrically congruent to `c = d` if `a = d` and `b = c`.\n\n**Note:** We previously used `congrPlaceholderProof` for this case, but it\ncaused non-termination during proof term construction when `a = b = c = d`.\nThe issue was that we did not have enough information to determine how\n`a = b` and `c = d` became congruent. The new marker resolves this issue.\n\nIf `congrPlaceholderProof` is used, then `a = b` became congruent to `c = d`\nbecause `a = c` and `b = d`.\nIf `eqCongrSymmPlaceholderProof` is used, then it was because `a = d` and `b = c`.\n\n**Example:** suppose we have the following equivalence class:\n```\n{p, q, p = q, q = p, True}\n```\nRecall that `True` is always the root of its equivalence class.\nAssume we also have the following two paths in the class:\n```\n1. p -> p = q -> q = p -> True\n2. q -> True\n```\nNow suppose we try to build a proof for `p = True`.\nWe must construct a proof for `(p = q) = (q = p)`.\nThese equalities are congruent, but if we try to prove `p = q` and `q = p`\nusing the facts `p = True` and `q = True`, we end up trying to prove `p = True` again.\nIn other words, we are missing the information that `p = q` became congruent to `q = p`\nbecause of the symmetric case. By using `eqCongrSymmPlaceholderProof`, we retain this information.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.eqCongrSymmPlaceholderProof","kind":"def","line":30,"name":"Lean.Meta.Grind.eqCongrSymmPlaceholderProof","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L30-L60"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.congrPlaceholderProof\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">Grind</span>.<span class=\"name\">congrPlaceholderProof</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></div></div>","info":{"doc":"We use this auxiliary constant to mark delayed congruence proofs.","docLink":"./Lean/Meta/Tactic/Grind/Types.html#Lean.Meta.Grind.congrPlaceholderProof","kind":"def","line":27,"name":"Lean.Meta.Grind.congrPlaceholderProof","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Meta/Tactic/Grind/Types.lean#L27-L28"}}],"imports":["Init.Data.Nat.Internal.Linear","Init.Data.Queue","Init.Data.String.Basic","Init.Grind.Config","Init.Omega","Lean.Meta.AbstractNestedProofs","Lean.Meta.Match.MatchEqsExt","Lean.Meta.Sym.Canon","Lean.Meta.Sym.DSimp.DSimpM","Lean.Meta.Sym.ObjectPtr","Lean.Meta.Sym.Simp.SimpM","Lean.Meta.Sym.SymM","Lean.Meta.Tactic.Grind.Attr","Lean.Meta.Tactic.Grind.CheckResult","Lean.Util.ShareCommon"],"instances":[{"className":"Inhabited","name":"Lean.Meta.Grind.instInhabitedSolverExtensionState","typeNames":["Lean.Meta.Grind.SolverExtensionState"]},{"className":"Inhabited","name":"Lean.Meta.Grind.instInhabitedSplitSource","typeNames":["Lean.Meta.Grind.SplitSource"]},{"className":"Inhabited","name":"Lean.Meta.Grind.instInhabitedEMatchDiagSource","typeNames":["Lean.Meta.Grind.EMatchDiagSource"]},{"className":"BEq","name":"Lean.Meta.Grind.instBEqCongrTheoremCacheKey","typeNames":["Lean.Meta.Grind.CongrTheoremCacheKey"]},{"className":"Hashable","name":"Lean.Meta.Grind.instHashableCongrTheoremCacheKey","typeNames":["Lean.Meta.Grind.CongrTheoremCacheKey"]},{"className":"Inhabited","name":"Lean.Meta.Grind.instInhabitedCounters","typeNames":["Lean.Meta.Grind.Counters"]},{"className":"Hashable","name":"Lean.Meta.Grind.instHashableEMatchDiagNode","typeNames":["Lean.Meta.Grind.EMatchDiagNode"]},{"className":"BEq","name":"Lean.Meta.Grind.instBEqEMatchDiagNode","typeNames":["Lean.Meta.Grind.EMatchDiagNode"]},{"className":"Inhabited","name":"Lean.Meta.Grind.instInhabitedEMatchDiagNode","typeNames":["Lean.Meta.Grind.EMatchDiagNode"]},{"className":"Inhabited","name":"Lean.Meta.Grind.instInhabitedEMatchDiagInfo","typeNames":["Lean.Meta.Grind.EMatchDiagInfo"]},{"className":"BEq","name":"Lean.Meta.Grind.instBEqHoistKey","ty