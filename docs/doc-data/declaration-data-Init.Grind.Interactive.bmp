s\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Shows the pending goals. ","docLink":"./Init/Grind/Interactive.html#Lean.Parser.Tactic.Grind.showGoals","kind":"def","line":112,"name":"Lean.Parser.Tactic.Grind.showGoals","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Grind/Interactive.lean#L112-L113"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Grind/Interactive.html#Lean.Parser.Tactic.Grind.showTerm\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Tactic</span>.<span class=\"name\">Grind</span>.<span class=\"name\">showTerm</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"`show_term tac` runs `tac`, then displays the generated proof in the InfoView.\n","docLink":"./Init/Grind/Interactive.html#Lean.Parser.Tactic.Grind.showTerm","kind":"def","line":107,"name":"Lean.Parser.Tactic.Grind.showTerm","sourceLink":"https://github.com/leanprover/lean4/blob/6a10ac8c22beadecabdbb0919c2b50214762f91d/src/Init/Grind/Interactive.lean#L107-L110"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./Init/Grind/Interactive.html#Lean.Parser.Tactic.Grind.showLocalThms\"><span class=\"name\">Lean</span>.<span class=\"name\">Parser</span>.<span class=\"name\">Tactic</span>.<span class=\"name\">Grind</span>.<span class=\"name\">showLocalThms</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Lean.ParserDescr\">ParserDescr</a></div></div>","info":{"doc":"Show active local theorems and their anchors for heuristic instantiation. ","docLink":"./Init/Grind/Inte