ecl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"`mkProjection s fieldName` returns an expression for accessing field `fieldName` of the structure `s`.\nRemark: `fieldName` may be a subfield of `s`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkProjection","kind":"opaque","line":533,"name":"Lean.Meta.mkProjection","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L533-L562"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkPure\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkPure</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">monad </span><span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given a `monad` and `e : α`, makes `pure e`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkPure","kind":"def","line":529,"name":"Lean.Meta.mkPure","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L529-L531"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkNoConfusion\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkNoConfusion</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">target </span><span class=\"fn\">h</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkNoConfusion","kind":"def","line":471,"name":"Lean.Meta.mkNoConfusion","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L471-L527"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqMPR\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqMPR</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">eqProof </span><span class=\"fn\">pr</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqMPR","kind":"def","line":468,"name":"Lean.Meta.mkEqMPR","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L468-L469"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqMP\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqMP</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">eqProof </span><span class=\"fn\">pr</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `h : α = β` and `a : α`, returns `Eq.mp h a : β`. The type of `a` is not checked.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqMP","kind":"def","line":461,"name":"Lean.Meta.mkEqMP","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L461-L466"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqMPCore\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqMPCore</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α </span><span class=\"fn\">β </span><span class=\"fn\">h </span><span class=\"fn\">a</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Returns `Eq.mp h a : β` for `h : α = β` and `a : α`, without inferring or checking the\ntypes of `h` and `a`. Use this when `α` is only definitionally equal to the type of `a`\nin a way `isDefEq` may fail to establish (e.g. after `zetaDelta` and ground evaluation).","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqMPCore","kind":"def","line":452,"name":"Lean.Meta.mkEqMPCore","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L452-L459"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqRec\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqRec</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">motive </span><span class=\"fn\">h1 </span><span class=\"fn\">h2</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqRec","kind":"def","line":436,"name":"Lean.Meta.mkEqRec","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L436-L450"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqNDRec\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqNDRec</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">motive </span><span class=\"fn\">h1 </span><span class=\"fn\">h2</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqNDRec","kind":"def","line":421,"name":"Lean.Meta.mkEqNDRec","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L421-L434"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppOptM'\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkAppOptM'</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">xs</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Similar to `mkAppOptM`, but takes an `Expr` instead of a constant name.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppOptM'","kind":"def","line":415,"name":"Lean.Meta.mkAppOptM'","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L415-L419"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppOptM\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkAppOptM</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">constName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">xs</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Similar to `mkAppM`, but it allows us to specify which arguments are provided explicitly using `Option` type.\nExample:\nGiven `Pure.pure {m : Type u → Type v} [Pure m] {α : Type u} (a : α) : m α`,\n```\nmkAppOptM `Pure.pure #[m, none, none, a]\n```\nreturns a `Pure.pure` application if the instance `Pure m` can be synthesized, and the universe match.\nNote that,\n```\nmkAppM `Pure.pure #[a]\n```\nfails because the only explicit argument `(a : α)` is not sufficient for inferring the remaining arguments,\nwe would need the expected type.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppOptM","kind":"def","line":396,"name":"Lean.Meta.mkAppOptM","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L396-L413"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppM'\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkAppM'</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">xs</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Similar to `mkAppM`, but takes an `Expr` instead of a constant name.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppM'","kind":"def","line":358,"name":"Lean.Meta.mkAppM'","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L358-L362"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppM\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkAppM</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">constName</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">xs</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Returns the application `constName xs`.\nIt tries to fill the implicit arguments before the last element in `xs`.\n\nRemark:\n``mkAppM `arbitrary #[α]`` returns `@arbitrary.{u} α` without synthesizing\nthe implicit argument occurring after `α`.\nGiven a `x : ([Decidable p] → Bool) × Nat`, ``mkAppM `Prod.fst #[x]``,\nreturns `@Prod.fst ([Decidable p] → Bool) Nat x`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkAppM","kind":"def","line":343,"name":"Lean.Meta.mkAppM","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L343-L356"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkCongr\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkCongr</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h₁ </span><span class=\"fn\">h₂</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `h₁ : f = g` and `h₂ : a = b`, returns a proof of `f a = g b`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkCongr","kind":"def","line":262,"name":"Lean.Meta.mkCongr","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L262-L281"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkCongrFun\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkCongrFun</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h </span><span class=\"fn\">a</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `h : f = g` and `a : α`, returns a proof of `f a = g a`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkCongrFun","kind":"def","line":239,"name":"Lean.Meta.mkCongrFun","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L239-L260"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">partial def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkCongrArg\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkCongrArg</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f </span><span class=\"fn\">h</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `f : α → β` and `h : a = b`, returns a proof of `f a = f b`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkCongrArg","kind":"opaque","line":219,"name":"Lean.Meta.mkCongrArg","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L219-L237"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.congrArg?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">congrArg?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> (<a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>))</span></span></div></div>","info":{"doc":"If `e` is `@congrArg α β a b f h`, returns `α`, `f` and `h`.\nAlso works if `e` can be turned into such an application (e.g. `congrFun`).","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.congrArg?","kind":"def","line":203,"name":"Lean.Meta.congrArg?","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L203-L217"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.isRefl?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">isRefl?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"If `e` is `@Eq.refl α a`, returns `a`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.isRefl?","kind":"def","line":194,"name":"Lean.Meta.isRefl?","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L194-L201"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkHEqOfEq\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkHEqOfEq</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `h : a = b`, returns a proof of `a ≍ b`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkHEqOfEq","kind":"def","line":186,"name":"Lean.Meta.mkHEqOfEq","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L186-L192"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqOfHEq\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqOfHEq</span></a> </span><span class=\"de