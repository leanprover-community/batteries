break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkHEqSymm\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkHEqSymm</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `h : a ≍ b`, returns a proof of `b ≍ a`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkHEqSymm","kind":"def","line":144,"name":"Lean.Meta.mkHEqSymm","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L144-L155"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqTrans?\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqTrans?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h₁? </span><span class=\"fn\">h₂?</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span></div></div>","info":{"doc":"Similar to `mkEqTrans`, but arguments can be `none`.\n`none` is treated as a reflexivity proof.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqTrans?","kind":"def","line":133,"name":"Lean.Meta.mkEqTrans?","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L133-L142"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqTrans\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqTrans</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h₁ </span><span class=\"fn\">h₂</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Meta/Basic.html#Lean.Meta.MetaM\">MetaM</a> <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></span></div></div>","info":{"doc":"Given `h₁ : a = b` and `h₂ : b = c`, returns a proof of `a = c`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqTrans","kind":"def","line":117,"name":"Lean.Meta.mkEqTrans","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Lean/Meta/AppBuilder.lean#L117-L131"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqTransCoreProp\"><span class=\"name\">Lean</span>.<span class=\"name\">Meta</span>.<span class=\"name\">mkEqTransCoreProp</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">a </span><span class=\"fn\">b </span><span class=\"fn\">c </span><span class=\"fn\">h₁ </span><span class=\"fn\">h₂</span> : <a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Lean/Expr.html#Lean.Expr\">Expr</a></div></div>","info":{"doc":"Given `h₁ : a = b` and `h₂ : b = c` for propositions `a b c`, returns a proof of `a = c`.","docLink":"./Lean/Meta/AppBuilder.html#Lean.Meta.mkEqTransCoreProp","kind":"def","line":113,"name":"Lean.Meta.mkEqTransCoreProp","sourceLink":"http