7e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L293-L298"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openLeaf\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">openLeaf</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Replaces the open leaf at the bottom of the spine, closing any prior one.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openLeaf","kind":"def","line":288,"name":"Lean.Markdown.BlockZipper.openLeaf","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L288-L291"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openItem\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">openItem</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">kind</span> : <a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.ListKind\">ListKind</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">marker</span> : <span class=\"fn\"><span class=\"fn\">s</span>.<a href=\"./Init/Data/String/Subslice.html#String.Slice.Subslice\">Subslice</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">contentColumn</span> : <a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.Columns\">Columns</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Opens a list item as the last child of the deepest open container, closing any open leaf first. The\nitem joins the container's pending list when that list is of the item's kind; otherwise the item\nbegins a new list. A blank line before the item makes the list that it joins loose.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openItem","kind":"def","line":271,"name":"Lean.Markdown.BlockZipper.openItem","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L271-L286"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openBlockquote\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">openBlockquote</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">markers</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\"><span class=\"fn\">s</span>.<a href=\"./Init/Data/String/Subslice.html#String.Slice.Subslice\">Subslice</a></span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Opens a blockquote as the last child of the deepest open container, closing any open leaf first.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openBlockquote","kind":"def","line":264,"name":"Lean.Markdown.BlockZipper.openBlockquote","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L264-L269"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.closeContainer\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">closeContainer</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Closes the deepest container. A blockquote becomes the last child of the container around it. A\nlist item is added to its list, which becomes the pending list of the container around it, since\nthe next line may add another item. Does nothing when only the document is open.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.closeContainer","kind":"def","line":245,"name":"Lean.Markdown.BlockZipper.closeContainer","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L245-L262"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.recordContentLine\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">recordContentLine</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Records a line that continues the open block. Any blank line before it was inside that block\ninstead of between two blocks, so it doesn't make any list loose.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.recordContentLine","kind":"def","line":215,"name":"Lean.Markdown.BlockZipper.recordContentLine","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L215-L220"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.recordBlankLine\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">recordBlankLine</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Records a blank line in the deepest open container.\n\nA blank line between two blocks of a list item, or between two items, makes the list loose\n(CommonMark §5.3). Which list that is depends on where the next block begins, so the blank line is\nremembered until then, along with the outermost list it could affect. A blank line inside a\nblockquote affects only the blockquote's own content.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.recordBlankLine","kind":"def","line":198,"name":"Lean.Markdown.BlockZipper.recordBlankLine","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L198-L213"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.listLikeFloor\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">listLikeFloor</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"The least spine index from which every deeper frame is a list item.\n\nIt is one past the deepest blockquote, or `0` when there is none.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.listLikeFloor","kind":"def","line":186,"name":"Lean.Markdown.BlockZipper.listLikeFloor","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L186-L196"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.closeLeaf\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">closeLeaf</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"Closes any open leaf, attaching it to the deepest container.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.closeLeaf","kind":"def","line":178,"name":"Lean.Markdown.BlockZipper.closeLeaf","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L178-L184"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.leafToBlock\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">leafToBlock</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span></span> → <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.Block.Raw\">Block.Raw</a> <span class=\"fn\">s</span></span></span></div></div>","info":{"doc":"Converts an open leaf into its closed `Block.Raw` form. Fenced code blocks are not terminated with a\nfence.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.leafToBlock","kind":"def","line":136,"name":"Lean.Markdown.BlockZipper.leafToBlock","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L136-L144"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.top?\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">top?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">z</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenContainer\">OpenContainer</a> <span class=\"fn\">s</span>)</span></span></div></div>","info":{"doc":"The deepest currently-open container, or `none` if only the document is open.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.top?","kind":"def","line":132,"name":"Lean.Markdown.BlockZipper.top?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L132-L134"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.empty\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">empty</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"A zipper with only the document root open, no children, and no open leaf.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.empty","kind":"def","line":129,"name":"Lean.Markdown.BlockZipper.empty","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L129-L130"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.instInhabitedBlockZipper\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">instInhabitedBlockZipper</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">a✝</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">a✝</span>)</span></span></div></div>","info":{"doc":"","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.instInhabitedBlockZipper","kind":"instance","line":123,"name":"Lean.Markdown.instInhabitedBlockZipper","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L123-L123"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.blankLineFloor?\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">blankLineFloor?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span></div></div>","info":{"doc":"The position in `spine` of the outermost list that the most recent blank line could still make\nloose (CommonMark §5.3), or `none` when there is no such list or the next block has begun. A list\nis at the position of its open item's frame, or one past the deepest frame when it is the pending\nlist of the deepest container.\n\nA blank line makes a list loose when the next block begins in one of the list's items. The lists\nit could make loose are therefore the open lists around it, from this position inward. The\noutermost of them is inside the nearest enclosing blockquote, because a blank line inside a\nblockquote separates blocks of the blockquote, not blocks of a list that contains the blockquote.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.blankLineFloor?","kind":"def","line":122,"name":"Lean.Markdown.BlockZipper.blankLineFloor?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L122-L122"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openLeaf?\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">openLeaf?</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span>)</span></span></div></div>","info":{"doc":"An open leaf node, if one is present.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.openLeaf?","kind":"def","line":110,"name":"Lean.Markdown.BlockZipper.openLeaf?","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L110-L110"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.spine\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">spine</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.ZipperFrame\">ZipperFrame</a> <span class=\"fn\">s</span>)</span></span></div></div>","info":{"doc":"Open containers below the document root, deepest last.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.spine","kind":"def","line":108,"name":"Lean.Markdown.BlockZipper.spine","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L108-L108"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.document\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">document</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">self</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">BlockZipper</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/Children.html#Lean.Markdown.Children\">Children</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"The children of the document root.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.document","kind":"def","line":106,"name":"Lean.Markdown.BlockZipper.document","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L106-L106"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.mk\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span>.<span class=\"name\">mk</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>} →\n  <span class=\"fn\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/Children.html#Lean.Markdown.Children\">Lean.Markdown.Children</a> <span class=\"fn\">s</span></span> →\n    <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.ZipperFrame\">Lean.Markdown.ZipperFrame</a> <span class=\"fn\">s</span>)</span></span> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">Lean.Markdown.OpenLeaf</a> <span class=\"fn\">s</span>)</span></span> → <span class=\"fn\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span> → <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\">Lean.Markdown.BlockZipper</a> <span class=\"fn\">s</span></span></span></span></span></span></span></div></div>","info":{"doc":"","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper.mk","kind":"ctor","line":90,"name":"Lean.Markdown.BlockZipper.mk","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L90-L123"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">structure</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">BlockZipper</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"The block parsing state. Maintains the spine of currently-open containers plus an optional open leaf\nat the bottom.\n\nAn empty spine means that only the document is open.\n\nInvariants:\n- If `openLeaf?` is `some _`, that leaf logically lives inside the deepest spine frame, or directly\n  under the document if the spine is empty. Extending the leaf adds to its content, and closing the\n  leaf pushes a `Block.Raw` onto that container's children.\n- A list contains only list items. An `OpenList` has items and nothing else, and every open list is\n  either the list of an item frame or the pending list of the container around it. `Children.push`,\n  the one operation that appends a block, finishes the pending list first.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.BlockZipper","kind":"structure","line":90,"name":"Lean.Markdown.BlockZipper","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L90-L123"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.instInhabitedOpenLeaf\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">instInhabitedOpenLeaf</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">a✝</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Inhabited\">Inhabited</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">a✝</span>)</span></span></div></div>","info":{"doc":"","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.instInhabitedOpenLeaf","kind":"instance","line":88,"name":"Lean.Markdown.instInhabitedOpenLeaf","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L88-L88"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.html\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">OpenLeaf</span>.<span class=\"name\">html</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">kind</span> : <a href=\"./Lean/Data/Markdown/Parser/Html.html#Lean.Markdown.HtmlBlockKind\">HtmlBlockKind</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lines</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.VerbatimLine\">VerbatimLine</a> <span class=\"fn\">s</span>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"An open HTML block. `kind` selects the end condition, and `lines` accumulates the block's lines,\nstarting with the one that met the start condition.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.html","kind":"ctor","line":83,"name":"Lean.Markdown.OpenLeaf.html","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L83-L87"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.indentedCode\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">OpenLeaf</span>.<span class=\"name\">indentedCode</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lines </span><span class=\"fn\">pendingBlanks</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.VerbatimLine\">VerbatimLine</a> <span class=\"fn\">s</span>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"An open indented code block.\n\n- `lines` are the content lines that have been committed so far, after the four columns of\n  indentation.\n- `pendingBlanks` records blank lines that may belong to this block. They are promoted to `lines`\n  when a subsequent indented line continues the block, and discarded when an unindented non-blank\n  line closes the block. This matches CommonMark's rule that blank lines between indented chunks\n  are part of the code block, but blank lines that follow the final chunk are not.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.indentedCode","kind":"ctor","line":72,"name":"Lean.Markdown.OpenLeaf.indentedCode","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L72-L82"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.fencedCode\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">OpenLeaf</span>.<span class=\"name\">fencedCode</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">info</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.FenceInfo\">FenceInfo</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">openFence</span> : <span class=\"fn\"><span class=\"fn\">s</span>.<a href=\"./Init/Data/String/Subslice.html#String.Slice.Subslice\">Subslice</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lines</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <span class=\"fn\">(<a href=\"./Lean/Data/Markdown/Block.html#Lean.Markdown.VerbatimLine\">VerbatimLine</a> <span class=\"fn\">s</span>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"An open fenced code block. `lines` accumulates content lines until either a matching closing fence\nappears (yielding `Block.Raw.fencedCode` with `closeFence? := some _`) or the parent container\ncloses at EOF (yielding `closeFence? := none`).","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.fencedCode","kind":"ctor","line":66,"name":"Lean.Markdown.OpenLeaf.fencedCode","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L66-L71"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.paragraph\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"name\">OpenLeaf</span>.<span class=\"name\">paragraph</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">s</span> : <a href=\"./Init/Data/String/Defs.html#String.Slice\">String.Slice</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lines</span> : <span class=\"fn\"><a href=\"./Lean/Data/Markdown/Lines.html#Lean.Markdown.Lines\">Lines</a> <span class=\"fn\">s</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\">OpenLeaf</a> <span class=\"fn\">s</span></span></div></div>","info":{"doc":"An open paragraph that is being extended line by line. Closing the paragraph (because of a blank\nline, a new block opener, or the parent container closing) finalizes it as `Block.Raw.paragraph`.","docLink":"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf.paragraph","kind":"ctor","line":61,"name":"Lean.Markdown.OpenLeaf.paragraph","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/Data/Markdown/Parser/BlockZipper.lean#L61-L65"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Data/Markdown/Parser/BlockZipper.html#Lean.Markdown.OpenLeaf\"><span class=\"name\">Lean</span>.<span class=\"name\">Markdown</span>.<span class=\"