an#L143-L153"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigits_nil\"><span class=\"name\">Nat</span>.<span class=\"name\">ofFinDigits_nil</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigits\">ofFinDigits</a> <a href=\"./Init/Prelude.html#List.nil\">[</a><a href=\"./Init/Prelude.html#List.nil\">]</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">0</span></div></div>","info":{"doc":"","docLink":"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigits_nil","kind":"theorem","line":141,"name":"Nat.ofFinDigits_nil","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L141-L141"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigitsRev_eq_ofFinDigits_reverse\"><span class=\"name\">Nat</span>.<span class=\"name\">ofFinDigitsRev_eq_ofFinDigits_reverse</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigitsRev\">ofFinDigitsRev</a> <span class=\"fn\">l</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigits\">ofFinDigits</a> <span class=\"fn\"><span class=\"fn\">l</span>.<a href=\"./Init/Data/List/Basic.html#List.reverse\">reverse</a></span></span></div></div>","info":{"doc":"","docLink":"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigitsRev_eq_ofFinDigits_reverse","kind":"theorem","line":137,"name":"Nat.ofFinDigitsRev_eq_ofFinDigits_reverse","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L137-L139"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixedRev_eq_reverse_toFinDigitsFixed\"><span class=\"name\">Nat</span>.<span class=\"name\">toFinDigitsFixedRev_eq_reverse_toFinDigitsFixed</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">base </span><span class=\"fn\">prec</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/NeZero.html#NeZero\">NeZero</a> <span class=\"fn\">base</span></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">n</span>.<a href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixedRev\">toFinDigitsFixedRev</a></span> <span class=\"fn\">base</span> <span class=\"fn\">prec</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">n</span>.<a href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixed\">toFinDigitsFixed</a></span> <span class=\"fn\">base</span> <span class=\"fn\">prec</span>)</span>.<a href=\"./Init/Data/List/Basic.html#List.reverse\">reverse</a></span></div></div>","info":{"doc":"","docLink":"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixedRev_eq_reverse_toFinDigitsFixed","kind":"theorem","line":131,"name":"Nat.toFinDigitsFixedRev_eq_reverse_toFinDigitsFixed","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L131-L135"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsRev_eq_reverse_toFinDigits\"><span class=\"name\">Nat</span>.<span class=\"name\">toFinDigitsRev_eq_reverse_toFinDigits</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\"><span class=\"fn\">n</span>.<a href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsRev\">toFinDigitsRev</a></span> <span class=\"fn\">base</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><span class=\"fn\">(<span class=\"fn\"><span class=\"fn\">n</span>.<a href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigits\">toFinDigits</a></span> <span class=\"fn\">base</span>)</span>.<a href=\"./Init/Data/List/Basic.html#List.reverse\">reverse</a></span></div></div>","info":{"doc":"","docLink":"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsRev_eq_reverse_toFinDigits","kind":"theorem","line":119,"name":"Nat.toFinDigitsRev_eq_reverse_toFinDigits","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L119-L129"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsRev\"><span class=\"name\">Nat</span>.<span class=\"name\">toFinDigitsRev</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n </span><span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span></div></div>","info":{"doc":"Little-endian list of digits of a natural number `n` in a given `base`.\n\nWhen `n` is zero, the result is the empty list. Otherwise, the most significant digit is nonzero.\nThe base should be at least 2, the result is always the empty list in \"base 0\" and \"base 1\".\n```\ntoFinDigitsRev 123 10 = ([3,2,1] : List (Fin 10))\ntoFinDigitsRev 4 2 = ([0,0,1] : List (Fin 2))\ntoFinDigitsRev 0 12345 = ([] : List (Fin 12345))\n```","docLink":"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsRev","kind":"def","line":100,"name":"Nat.toFinDigitsRev","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L100-L115"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigits\"><span class=\"name\">Nat</span>.<span class=\"name\">toFinDigits</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n </span><span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span></div></div>","info":{"doc":"Big-endian list of digits of a natural number `n` in a given `base`.\n\nWhen `n` is zero, the result is the empty list. Otherwise, the most significant digit is nonzero.\nThe base should be at least 2, the result is always the empty list in \"base 0\" and \"base 1\".\n```\ntoFinDigits 123 10 = ([1,2,3] : List (Fin 10))\ntoFinDigits 4 2 = ([1,0,0] : List (Fin 2))\ntoFinDigits 0 12345 = ([] : List (Fin 12345))\n```","docLink":"./Batteries/Data/Nat/Digits.html#Nat.toFinDigits","kind":"def","line":83,"name":"Nat.toFinDigits","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L83-L98"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixedRev\"><span class=\"name\">Nat</span>.<span class=\"name\">toFinDigitsFixedRev</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n </span><span class=\"fn\">base </span><span class=\"fn\">prec</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/NeZero.html#NeZero\">NeZero</a> <span class=\"fn\">base</span></span>]</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span></div></div>","info":{"doc":"The `prec` least significant digits of `n` in the given `base`, listed in little-endian order.\n\nOnly \"base 0\" is invalid, this is ensured by a `NeZero base` instance. In \"base 1\" the result is\nalways a list of `0`s with length `prec`.\n```\ntoFinDigitsFixedRev 123 10 3 = ([3,2,1] : List (Fin 10))\ntoFinDigitsFixedRev 123 10 2 = ([3,2] : List (Fin 10))\ntoFinDigitsFixedRev 4 2 4 = ([0,0,1,0] : List (Fin 2))\ntoFinDigitsFixedRev 12345 1 5 = ([0,0,0,0,0] : List (Fin 1))\n```","docLink":"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixedRev","kind":"def","line":66,"name":"Nat.toFinDigitsFixedRev","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L66-L81"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixed\"><span class=\"name\">Nat</span>.<span class=\"name\">toFinDigitsFixed</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">n </span><span class=\"fn\">base </span><span class=\"fn\">prec</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/NeZero.html#NeZero\">NeZero</a> <span class=\"fn\">base</span></span>]</span></span> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span></div></div>","info":{"doc":"The `prec` least significant digits of `n` in the given `base`, listed in big-endian order.\n\nOnly \"base 0\" is invalid, this is ensured by a `NeZero base` instance. In \"base 1\" the result is\nalways a list of `0`s with length `prec`.\n```\ntoFinDigitsFixed 123 10 3 = ([1,2,3] : List (Fin 10))\ntoFinDigitsFixed 123 10 2 = ([2,3] : List (Fin 10))\ntoFinDigitsFixed 4 2 4 = ([0,1,0,0] : List (Fin 2))\ntoFinDigitsFixed 12345 1 5 = ([0,0,0,0,0] : List (Fin 1))\n```","docLink":"./Batteries/Data/Nat/Digits.html#Nat.toFinDigitsFixed","kind":"def","line":49,"name":"Nat.toFinDigitsFixed","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L49-L64"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigitsRev\"><span class=\"name\">Nat</span>.<span class=\"name\">ofFinDigitsRev</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"Construct a natural number from a little-endian list of digits in the given base:\n```\nofFinDigitsRev (base := 10) [4,3,2] = 234 -- 2*10^2 + 3*10^1 + 4*10^0\nofFinDigitsRev (base := 2) [0,0,1,0] = 4 -- 0*2^3 + 1*2^2 + 0*2^1 + 0*2^0\nofFinDigitsRev (base := b) [] = 0 -- any base, including \"base 0\" and \"base 1\"\n```\nThere are no valid inputs other than `[]` in \"base 0\". In \"base 1\", the only valid digit is `0`\nand therefore `ofFinDigitsRev (base := 1) l = 0`.","docLink":"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigitsRev","kind":"def","line":36,"name":"Nat.ofFinDigitsRev","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L36-L47"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigits\"><span class=\"name\">Nat</span>.<span class=\"name\">ofFinDigits</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">base</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">l</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <span class=\"fn\">(<a href=\"./Init/Prelude.html#Fin\">Fin</a> <span class=\"fn\">base</span>)</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Nat\">Nat</a></div></div>","info":{"doc":"Construct a natural number from a big-endian list of digits in the given base:\n```\nofFinDigits (base := 10) [2,3,4] = 234 -- 2*10^2 + 3*10^1 + 4*10^0\nofFinDigits (base := 2) [0,1,0,0] = 4 -- 0*2^3 + 1*2^2 + 0*2^1 + 0*2^0\nofFinDigits (base := b) [] = 0 -- any base, including \"base 0\" and \"base 1\"\n```\nThere are no valid inputs other than `[]` in \"base 0\". In \"base 1\", the only valid digit is `0`\nand therefore `ofFinDigits (base := 1) l = 0`.","docLink":"./Batteries/Data/Nat/Digits.html#Nat.ofFinDigits","kind":"def","line":23,"name":"Nat.ofFinDigits","sourceLink":"https://github.com/leanprover-community/batteries/blob/7d582b1508dece342d9bea5327cc0f1843c1b6fa/Batteries/Data/Nat/Digits.lean#L23-L34"}}],"imports":["Batteries.Tactic.Init","Init"],"instances":[],"name":"Batteries.Data.Nat.Digits"}