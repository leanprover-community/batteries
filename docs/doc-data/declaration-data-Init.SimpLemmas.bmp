nk":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/SimpLemmas.lean#L72-L75"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/SimpLemmas.html#Lean.arrow_congr_right\"><span class=\"name\">Lean</span>.<span class=\"name\">arrow_congr_right</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">p</span> : <a href=\"./foundational_types.html\">Sort</a> u}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">q₁ </span><span class=\"fn\">q₂</span> : <a href=\"./foundational_types.html\">Sort</a> v}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\">q₁</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">q₂</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/SimpLemmas.html#Lean.Arrow\">Arrow</a> <span class=\"fn\">p</span> <span class=\"fn\">q₁</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./Init/SimpLemmas.html#Lean.Arrow\">Arrow</a> <span class=\"fn\">p</span> <span class=\"fn\">q₂</span></span></div></div>","info":{"doc":"","docLink":"./Init/SimpLemmas.html#Lean.arrow_congr_right","kind":"theorem","line":69,"name":"Lean.arrow_congr_right","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/SimpLemmas.lean#L69-L70"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/SimpLemmas.html#Lean.arrow_congr_left\"><span class=\"name\">Lean</span>.<span class=\"name\">arrow_congr_left</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">p₁ </span><span class=\"fn\">p₂</span> : <a href=\"./foundational_types.html\">Sort</a> u}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">q</span> : <a href=\"./foundational_types.html\">Sort</a> v}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\">p₁</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">p₂</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/SimpLemmas.html#Lean.Arrow\">Arrow</a> <span class=\"fn\">p₁</span> <span class=\"fn\">q</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./Init/SimpLemmas.html#Lean.Arrow\">Arrow</a> <span class=\"fn\">p₂</span> <span class=\"fn\">q</span></span></div></div>","info":{"doc":"","docLink":"./Init/SimpLemmas.html#Lean.arrow_congr_left","kind":"theorem","line":66,"name":"Lean.arrow_congr_left","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/SimpLemmas.lean#L66-L67"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/SimpLemmas.html#Lean.arrow_congr\"><span class=\"name\">Lean</span>.<span class=\"name\">arrow_congr</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">p₁ </span><span class=\"fn\">p₂</span> : <a href=\"./foundational_types.html\">Sort</a> u}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">q₁ </span><span class=\"fn\">q₂</span> : <a href=\"./foundational_types.html\">Sort</a> v}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h₁</span> : <span class=\"fn\">p₁</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">p₂</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h₂</span> : <span class=\"fn\">q₁</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">q₂</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/SimpLemmas.html#Lean.Arrow\">Arrow</a> <span class=\"fn\">p₁</span> <span class=\"fn\">q₁</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./Init/SimpLemmas.html#Lean.Arrow\">Arrow</a> <span class=\"fn\">p₂</span> <span class=\"fn\">q₂</span></span></div></div>","info":{"doc":"","docLink":"./Init/SimpLemmas.html#Lean.arrow_congr","kind":"theorem","line":63,"name":"Lean.arrow_congr","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/SimpLemmas.lean#L63-L64"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/SimpLemmas.html#Lean.Arrow\"><span class=\"name\">Lean</span>.<span class=\"name\">Arrow</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Sort</a> u)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Sort</a> v)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Sort</a> (imax u v)</div></div>","info":{"doc":"`Arrow α β` is definitionally equal to `α → β`, but represented as a function\napplication rather than `Expr.forallE`.\n\nThis representation is useful for proof automation that builds nested implications\nlike `pₙ → ... → p₂ → p₁`. With `Expr.forallE`, each nesting level introduces a\nbinder that bumps de Bruijn indices in subterms, destroying sharing even with\nhash-consing. For example, if `p₁` contains `#20`, then at depth 2 it becomes `#21`,\nat depth 3 it becomes `#22`, etc., causing quadratic proof growth.\n\nWith `arrow`, both arguments are explicit (not under binders), so subterms remain\nidentical across nesting levels and can be shared, yielding linear-sized proofs.","docLink":"./Init/SimpLemmas.html#Lean.Arrow","kind":"def","line":48,"name":"Lean.Arrow","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/SimpLemmas.lean#L48-L61"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/SimpLemmas.html#implies_congr_right\"><span class=\"name\">implies_congr_right</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">p</span> : <a href=\"./foundational_types.html\">Sort</a> u}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">q₁ </span><span class=\"fn\">q₂</span> : <a href=\"./foundational_types.html\">Sort</a> v}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\">q₁</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">q₂</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\">(<span class=\"fn\">p</span> → <span class=\"fn\">q₁</span>)</span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">(<span class=\"fn\">p</span> → <span class=\"fn\">q₂</span>)</span></div></div>","info":{"doc":"","docLink":"./Init/SimpLemmas.html#implies_congr_right","kind":"theorem","line":44,"name":"implies_congr_right","sourceLink":"https://github.com/leanprover/lean4/blob/c9afcddf514a6772bd4d649f7cfc04eff0b9f15e/src/Init/SimpLemmas.lean#L44-L45"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Init/SimpLemmas.html#implies_congr_left\"><span class=\"name\">implies_congr_left</span></a> </span><span class