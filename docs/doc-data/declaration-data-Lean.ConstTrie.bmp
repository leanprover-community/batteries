21/src/Lean/ConstTrie.lean#L41-L41"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">constructor</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/ConstTrie.html#Lean.ConstTrie.leaf\"><span class=\"name\">Lean</span>.<span class=\"name\">ConstTrie</span>.<span class=\"name\">leaf</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">key</span> : <a href=\"./Init/Prelude.html#Lean.Name\">Name</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">val</span> : <span class=\"fn\">α</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/ConstTrie.html#Lean.ConstTrie\">ConstTrie</a> <span class=\"fn\">α</span></span></div></div>","info":{"doc":"","docLink":"./Lean/ConstTrie.html#Lean.ConstTrie.leaf","kind":"ctor","line":40,"name":"Lean.ConstTrie.leaf","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/ConstTrie.lean#L40-L40"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">inductive</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/ConstTrie.html#Lean.ConstTrie\"><span class=\"name\">Lean</span>.<span class=\"name\">ConstTrie</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./foundational_types.html\">Type</a></div></div>","info":{"doc":"A prefix tree over the constant names of a single module, keyed on name components. `key` is the\nfull name prefix represented by a node. `children` is sorted by the (cached) hash of the child keys\nand searched by binary search; as all children extend `key` by one component, comparing that final\ncomponent suffices to disambiguate equal hashes. Nodes are split by shape so that leaves and\nvalue-less nodes store no unused fields.","docLink":"./Lean/ConstTrie.html#Lean.ConstTrie","kind":"inductive","line":32,"name":"Lean.ConstTrie","sourceLink":"https://github.com/leanprover/lean4/blob/0b77e12952ad39077d80d8bd6b66d601f225c321/src/Lean/ConstTrie.lean#L32-L42"}}],"imports":["Init.Data.Array.Lemmas","Init.Data.Array.Mem","Init.Data.Array.Monadic","Init.Data.Array.QSort","Init.Data.Option.BasicAux","Init.Omega","Init.System.IO","Init.While","Lean.Data.Name","Std.Data.HashMap.Basic","Std.Data.HashSet.Basic"],"instances":[{"className":"Inhabited","name":"Lean.instInhabitedConstTrie","typeNames":["Lean.ConstTrie"]},{"className":"Nonempty","name":"Lean.instNonemptyLookupCache","typeNames":["Lean.LookupCache"]},{"className":"Inhabited","name":"Lean.instInhabitedImportedTree","typeNames":["Lean.ImportedTree"]},{"className":"Inhabited","name":"Lean.instInhabitedImportedConsts","typeNames":["Lean.ImportedConsts"]},{"className":"GetElem?","name":"Lean.ImportedConsts.instGetElem?NameTrueOfInhabited","typeNames":["Lean.ImportedConsts","Lean.Name"]},{"className":"ForM","name":"Lean.ImportedConsts.instForMProdNameOfMonad","typeNames":["Lean.ImportedConsts","Prod"]},{"className":"ForIn","name":"Lean.ImportedConsts.instForInProdNameOfMonad","typeNames":["Lean.ImportedConsts","Prod"]}],"name":"Lean.ConstTrie"}